      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "اقلي الدونت مع التقليب حتى يذهب، ثم صفيها على ورق واتركيها تبرد."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "اخلطي السكر الناعم والفانيليا والكريمة لتغطية سميكة ناعمة."
