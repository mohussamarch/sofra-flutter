        "sourceStepIndices": [
          0
        ],
        "summaryAr": "اعجني كوبين من الدقيق مع الخميرة والبيكنج باودر والملح والسكر والحليب، ثم أضيفي الزيت والماء والفانيليا؛ زيدي بقية الدقيق إن لانت واعجني 4–5 دقائق."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "ضعي العجين في وعاء مزيت وغطيه ساعة أو حتى يتضاعف."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "جهزي طبق فرن 13×9."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "حضري طبقاً للزبدة وآخر للقرفة والسكر."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "قسمي العجين كرات بوصة؛ قطعي الجبن أربعة، احشي كل كرة وأغلقيها، اغمسيها بالزبدة ثم خليط القرفة والسكر."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "رتبي الكرات واتركيها دافئة 10–15 دقيقة."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "سخني الفرن إلى 180°م."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "اخبزي 30–35 دقيقة حتى تصبح ذهبية."
      },
      {
        "sourceStepIndices": [
          8
        ],
        "summaryAr": "بعد إخراجها وزعي الحليب المكثف مباشرة فوقها."
      }
    ]
  },
