        "sourceStepIndices": [
          0
        ],
        "summaryAr": "اخلطي مكونات العجين السائلة والجافة بالخلاط حتى يصبح المزيج رقيقاً."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "اتركي الخليط دافئاً 3 ساعات مع تقليبه دورياً لإخراج فقاعات التخمير."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "سخني صاجاً سميكاً جداً وجهزي صينية عليها فوطة قطنية."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "اسكبي دوائر على الصاج ولا تقلبيها؛ انقليها حين تظهر الفقاعات ويجف الوجه، وكرري ثم غطي الأقراص."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "حضري القشطة بخفق الحليب والكريمة والدقيق والنشا والسكر، اطهيها مع التحريك حتى تغلي وتثخن، ثم دقيقة أو دقيقتين واتركيها تبرد."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "اخلطي البندق والجوز والزبيب والقرفة للحشو."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "احشي كل قرص بملعقة قشطة أو مكسرات وأغلقيه نصف دائرة."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "سخني زيتاً أو سمناً أو كليهما في عمق يقارب بوصتين على نار متوسطة."
      },
      {
        "sourceStepIndices": [
          8
        ],
        "summaryAr": "اقلي الأقراص المحشوة حتى تكتسب لوناً ذهبياً."
      },
      {
        "sourceStepIndices": [
          9
        ],
        "summaryAr": "اغمسيها فوراً في الشيرة دقائق ثم ارفعيها وقدميها ساخنة."
      }
    ]
  },
