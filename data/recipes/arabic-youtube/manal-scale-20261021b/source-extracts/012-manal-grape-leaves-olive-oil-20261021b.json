        ],
        "summaryAr": "اغسلي ورق العنب جيداً."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "اغسلي الأرز وانقعيه نحو نصف ساعة ثم صفيه."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "أضيفي البصل والطماطم والنعناع والبقدونس والملح والفلفل ودبس الرمان الاختياري والليمون ونصف الزيت."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "قلبي الحشوة برفق حتى تتوزع."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "ضعي نحو ملعقة كبيرة حشو على الورقة واثني الجانبين ثم لفيها بإحكام."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "افرشي قاع القدر بأوراق غير محشوة ورتبي اللفائف متلاصقة."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "ضعي طبقاً ثقيلاً فوقها لتثبيتها أثناء الطهي."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "سخني سوائل الحشو المتبقية مع مكعب المرق الاختياري وبقية الزيت ثم اسكبيها فوق اللفائف."
      },
      {
        "sourceStepIndices": [
          8
        ],
        "summaryAr": "اغلي على نار متوسطة ثم غطي وخففي النار قرابة ساعة حتى يمتص المرق وتنضج؛ قدميها باردة."
      }
    ]
  },
