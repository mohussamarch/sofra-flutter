        "summaryAr": "سخني الفرن إلى 180° وجهزي طبق فرن أو أطباقاً فردية."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "افرمي اللحم والبصل والثوم والبقدونس والكزبرة والفلفل."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "تبلي بالبهار والملح والفلفل واعجني حتى تصير الكفتة متماسكة ناعمة."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "شكليها أصابع صغيرة."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "سخني زيت الزيتون واقلي الأصابع حتى يتحمر وجهها، اقلبيها لتتماسك وتتحمر الجهة الأخرى."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "انقلي الأصابع إلى طبق الفرن."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "اخفقي اللبن والطحينة والليمون والملح حتى تصير صلصة ناعمة."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "حمري البصل والثوم بالزيت حتى يذهبا للون الذهبي."
      },
      {
        "sourceStepIndices": [
          8
        ],
        "summaryAr": "أضيفي صلصة الطحينة وقلبي حتى تغلي دقيقة أو دقيقتين ثم اسكبيها على الكفتة."
      },
      {
        "sourceStepIndices": [
          9
        ],
        "summaryAr": "اخبزي 15 دقيقة."
      },
