        "summaryAr": "عجن 3 أكواب دقيق مع الخميرة والسكر والملح والزيت واللبن والحليب؛ زيادة الدقيق إذا لانت العجينة، ثم عجن ببطء 5 دقائق."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "وضع العجين في وعاء مدهون ومسح سطحه بالزيت وتركه دافئاً مغطى 60 دقيقة ليتضاعف."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "تفتيت الفيتا وخلطها بالنعناع وزيت الزيتون للحشو."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "مزج البيض والحليب للدهن."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "فرد العجين إلى سماكة 3–4 ملم وتقطيعه دوائر."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "حشو الأقراص وطيها وإغلاق حوافها وتركها 10 دقائق متباعدة في الصينية."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "تسخين الفرن إلى 200م."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "دهن الوجه بمزيج البيض ونثر حبة البركة."
      },
      {
        "sourceStepIndices": [
          8
        ],
        "summaryAr": "خبزها 10–15 دقيقة حتى تكتسب اللون الذهبي وتقديمها دافئة."
      }
    ]
