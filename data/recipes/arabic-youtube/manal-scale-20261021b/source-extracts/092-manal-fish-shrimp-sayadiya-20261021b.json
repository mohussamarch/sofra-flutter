          0
        ],
        "summaryAr": "وضع السمك والروبيان في طبق واسع."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "مزج الكزبرة والكمون والكركم والفلفل والملح."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "تتبيل السمك والروبيان بثلث خليط البهارات وملعقتين زيت."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "تجهيز طبق دقيق للتغليف."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "تسخين زيت عميق بارتفاع نحو بوصتين."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "تغليف السمك بالدقيق وقليه حتى يذهب للذهبي، ثم قلي الروبيان وتصفيتهما على ورق."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "يمكن استخدام مقلاة كهربائية للقلي."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "تحمير البصل بالزيت حتى يصبح بنياً داكناً دون حرق، ورفع جزء للتزيين."
      },
      {
        "sourceStepIndices": [
          8
        ],
        "summaryAr": "نقل زيت قلي البصل إلى قدر آخر جانباً."
      },
      {
        "sourceStepIndices": [
          9
        ],
        "summaryAr": "إضافة بعض البهارات والثوم والكرفس والكزبرة والزنجبيل والقرنفل والهيل وقليل ماء للبصل وطبخ الصلصة؛ إضافة ماء إذا جفت."
      },
      {
        "sourceStepIndices": [
          10
        ],
        "summaryAr": "غسل الأرز ونقعه نحو نصف ساعة."
      },
      {
        "sourceStepIndices": [
          11
        ],
        "summaryAr": "تقليب الثوم والبصل بالزيت المحفوظ حتى يذهب البصل للذهبي، ثم إضافة كوبين ماء وغليهما."
      },
      {
        "sourceStepIndices": [
          12
        ],
        "summaryAr": "تصفية الصلصة البنية فوق البصل والضغط لاستخراج السائل."
      },
      {
        "sourceStepIndices": [
          13
        ],
        "summaryAr": "إضافة الأرز وباقي البهارات وماء بحسب الحاجة وطهيه حتى يتشرب، ثم تغطيته 30 دقيقة على هدوء."
      },
      {
        "sourceStepIndices": [
          14
        ],
        "summaryAr": "تقديم الأرز مع السمك والروبيان وتزيينه بالبصل والصنوبر."
      }
