        "summaryAr": "قطعي فيليه الدجاج شرائح رفيعة."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "اخلطي الكاتشب والصويا والخردل والمايونيز والبابريكا والثوم والبصل المجفف والأوريجانو والكزبرة والكمون والملح والفلفل للتتبيلة."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "أضيفي الدجاج وقلبيه لتغطيته واتركيه دقائق."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "سخني ملعقة زيت وقلي الدجاج مع تتبيلته على نار قوية 7–8 دقائق حتى يجف وينضج."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "في مقلاة أخرى سخني بقية الزيت، ليّني البصل والثوم دقيقة ثم أضيفي الفلفل لدقيقة مع إبقائهما مقرمشين."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "اخلطي البصل والفلفل مع الدجاج وأبقي الخليط ساخناً."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "افتحي خبز الصامولي طولياً وادهنيه بالمايونيز والكاتشب."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "أضيفي الطماطم والمخلل والخس والدجاج وقدميه فوراً."
      }
    ]
