      {
        "sourceStepIndices": [
          0
        ],
        "summaryAr": "اخلطي الدقيق والملح والكمون، وسخني الحليب والزيت ثم أضيفيهما واعجني حتى تتكون عجينة طرية."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "غطي العجين واتركيه يرتاح نحو ساعة."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "قطعيه كرات وافرديها دوائر رقيقة ثم اقطعي كل دائرة نصفين واطويها مثلثاً مجوفاً."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "املئي كل مثلث بالحشو واضغطي الحواف حتى تلتحم."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "سخني زيتاً بعمق بوصتين على نار متوسطة."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "اقلي السمبوسك على دفعات حتى يصبح ذهبياً وقدمي فوراً."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "للحشو الأول اطهي اللحم بالزيت، أضيفي البصل والملح والفلفل والبهار حتى يلين، ثم البقدونس واتركيه يبرد."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "للحشو الثاني اطهي اللحم بالزيت وتوابله والبصل حتى يلين، أضيفي الجوز واتركيه يبرد."
      },
      {
        "sourceStepIndices": [
          8
        ],
        "summaryAr": "للحشو الثالث اطهي اللحم مع البصل والملح والفلفل والكاري، ثم اخلطيه بالجزر والفلفلين والكزبرة واتركيه يبرد."
      }
    ]
  },
