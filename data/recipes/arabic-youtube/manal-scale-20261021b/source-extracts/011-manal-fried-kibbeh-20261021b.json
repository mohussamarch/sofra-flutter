        ],
        "summaryAr": "اغسلي البرغل وانقعيه بماء بارد نصف ساعة."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "جهزي مفرمة بقرص ثقوبه صغيرة ووعاء أسفلها ومكعبات ثلج."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "افرمي البرغل واللحم والبصل مع إضافة الثلج، ثم أعيدي الفرم حتى ينعّم الخليط."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "تبلي العجين بالملح والفلفل والمردقوش واعجنيه أو اخلطيه حتى يتجانس."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "للحشو: حمري اللحم بالسمن حتى يجف ويحمر، أضيفي البصل دقيقة أو دقيقتين ثم أبعدي القدر وأضيفي الملح والفلفل وبهار اللحم والسماق والصنوبر."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "حضري ماءً مثلجاً لتبليل اليدين عند التشكيل."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "شكلي العجين قشرة رقيقة مجوفة حول الإصبع مع ترطيب اليدين."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "ضعي ملعقة صغيرة حشو وأغلقيها وشكليها بيضاوية مدببة."
      },
      {
        "sourceStepIndices": [
          8
        ],
        "summaryAr": "سخني الزيت بعمق يقارب بوصتين على نار متوسطة."
      },
      {
        "sourceStepIndices": [
          9
        ],
        "summaryAr": "اقلي عدة حبات مع التقليب بعد دقائق حتى تصبح ذهبية؛ قدميها ساخنة."
      }
    ]
  },
