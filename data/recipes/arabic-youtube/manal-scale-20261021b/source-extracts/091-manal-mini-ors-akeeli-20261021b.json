        "summaryAr": "تسخين الفرن إلى 180م وتجهيز قوالب صغيرة مبطنة أو مدهونة ورش بعضها بالسمسم."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "نقع الزعفران بالحليب حتى يتلون."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "نخل الدقيق والبيكنج باودر والملح وإضافة الهيل."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "خفق السكر والبيض 4–5 دقائق حتى يتضاعف الحجم ويفتح لونه."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "إضافة الزيت ببطء مع الخفق."
