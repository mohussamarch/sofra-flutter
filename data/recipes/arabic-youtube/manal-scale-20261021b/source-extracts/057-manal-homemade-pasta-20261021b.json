    "sourceStepCount": 14,
    "segments": [
      {
        "sourceStepIndices": [
          0
        ],
        "summaryAr": "خلط الدقيق والملح ثم إضافة البيض والزيت بالعجانة."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "عجن المزيج حتى يتشكل؛ إضافة الماء تدريجياً بملعقة عند جفافه حتى تتكون عجينة متماسكة."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "عجنها 4–6 دقائق ببطء، تكويرها وتغطيتها وتركها لترتاح."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "تجهيز صينية بفوطة مرشوشة بالدقيق."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "تقسيم العجينة أربعة أجزاء وإبقاء غير المستخدم مغطى."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "فرد كل جزء بماكينة المعكرونة إلى مستطيل رقيق مع رش الدقيق عند الحاجة."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "رش الدقيق لمنع الالتصاق بالماكينة."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "تقطيع العجين للشكل المرغوب مثل أشرطة أو مستطيلات أو أصابع."
      },
      {
        "sourceStepIndices": [
          8
        ],
        "summaryAr": "تجفيف القطع متباعدة نحو 10 دقائق على فوطة أو منشر."
      },
      {
        "sourceStepIndices": [
          9
        ],
        "summaryAr": "للحفظ: تجفيفها تماماً ووضعها في كيس أو وعاء محكم بمكان جاف."
      },
      {
        "sourceStepIndices": [
          10
        ],
        "summaryAr": "لسلقها: غلي ماء وفير مع ملعقة ملح لكل 3 لتر، وإضافة قليل زيت للعجين المنزلي، ثم تقليب المعكرونة."
      },
      {
        "sourceStepIndices": [
          11
        ],
        "summaryAr": "سلقها 6–8 دقائق بحسب الحجم والنوع، ثم تصفيتها دون شطف."
      },
      {
        "sourceStepIndices": [
          12
        ],
        "summaryAr": "تدفئة الصلصة وخلطها مع المعكرونة على نار هادئة."
      },
      {
        "sourceStepIndices": [
          13
        ],
        "summaryAr": "تقديمها مباشرة في طبق دافئ."
      }
    ]
  },
