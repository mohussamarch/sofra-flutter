        "summaryAr": "اخلطي بهار السمك والملح والكركم والكمون والكزبرة والبابريكا والفلفل."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "افركي السمكة بالتوابل من الداخل والخارج."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "اخلطي البصل والكرفس والثوم والجزر والزنجبيل والكزبرة والنعناع والبصل الأخضر والطماطم."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "افرشي نصف الليمون ونصف الخضار في طبق فرن؛ احشي السمكة بالبقية وضعيها فوق الخضار."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "اخلطي الخل ومعجون الطماطم والتمر الهندي ووزعيه على السمك؛ أضيفي شرائح الليمون وزيت الزيتون."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "غطي الطبق بالألمنيوم."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "سخني الفرن إلى 180°م."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "اخبزي 30 دقيقة حتى ينضج السمك."
      }
