      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "أضيفي الأرز المصفى وبقية البهارات، دعيه يمتص معظم المرق ثم غطيه على نار هادئة 40 دقيقة."
      },
      {
        "sourceStepIndices": [
