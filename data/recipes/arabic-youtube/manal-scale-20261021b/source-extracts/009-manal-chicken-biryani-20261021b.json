        ],
        "summaryAr": "أذيبي السمن وقلبي الهيل والفلفل والشطة والكركم والكمون والملح ثواني حتى تفوح رائحتها."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "أضيفي البصل والثوم والزنجبيل والفلفل الأخضر وقلبي حتى تتحمص."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "أضيفي الدجاج وقلبيه مع البهارات."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "أضيفي الطماطم واللبن والغار والقرفة والنعناع والكزبرة وغطي 10 دقائق؛ أضيفي كوب ماء وغطي واطهي 50 دقيقة حتى ينضج ويبقى قليل مرق."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "اغسلي الأرز وانقعيه نصف ساعة."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "انقعي الزعفران بماء الورد."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "حمري اللوز بالسمن وارفعِيه، ثم اقلي الزبيب حتى ينتفخ وارفعِيه."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "قلبي البصل والزنجبيل والهيل والقرنفل والقرفة دقيقة أو دقيقتين؛ أضيفي الأرز المصفى وقلبيه ثم 4 أكواب ماء واغليه حتى يمتص معظم السائل وتظهر ثقوب السطح."
      },
      {
        "sourceStepIndices": [
          8
        ],
        "summaryAr": "وزعي الدجاج والمرق المتبقي فوق الأرز وغطيه على نار هادئة جداً 50 دقيقة حتى ينضج ويتشرب."
      },
      {
        "sourceStepIndices": [
          9
        ],
        "summaryAr": "ارفعي الدجاج وقلبي الأرز بالشوكة ثم قدميهما مع اللوز والزبيب المقلي وسلطة أو دقوس."
      }
    ]
  },
