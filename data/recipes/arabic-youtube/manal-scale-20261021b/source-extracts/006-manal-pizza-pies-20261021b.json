        ],
        "summaryAr": "شكليها كرة وضعيها في طبق مدهون وادهني سطحها بقليل زيت."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "غطيها واتركيها دافئة حتى يتضاعف حجمها."
      },
