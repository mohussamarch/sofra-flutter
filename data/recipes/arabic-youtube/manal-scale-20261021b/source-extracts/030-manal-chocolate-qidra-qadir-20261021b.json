        "summaryAr": "سخني الفرن 180° وجهزي قالباً وسطه مفتوحاً داخل صينية مرتفعة؛ أضيفي ماءً للصينية حتى منتصف القالب."
      },
      {
        "sourceStepIndices": [
          1
        ],
        "summaryAr": "أذيبي السكر والماء على نار متوسطة حتى يصبح كهرمانياً، اسكبيه في القالب ووزعيه على القاع والجوانب واتركيه يبرد قليلاً."
      },
      {
        "sourceStepIndices": [
          2
        ],
        "summaryAr": "اخفقي البيض والفانيليا والحليب المكثف والحليب والجبن حتى يتجانس الكريم واسكبيه فوق الكراميل."
      },
      {
        "sourceStepIndices": [
          3
        ],
        "summaryAr": "انخلي الدقيق والكاكاو والبيكنج باودر والبيكربونات والملح."
      },
      {
        "sourceStepIndices": [
          4
        ],
        "summaryAr": "اخفقي الزبدة والسكر ثم أضيفي البيض والفانيليا."
      },
      {
        "sourceStepIndices": [
          5
        ],
        "summaryAr": "أضيفي الشوكولاتة واخلطي."
      },
      {
        "sourceStepIndices": [
          6
        ],
        "summaryAr": "أضيفي خليط الدقيق والماء حتى يختفي الدقيق."
      },
      {
        "sourceStepIndices": [
          7
        ],
        "summaryAr": "ضعي القالب في حمام الماء داخل الفرن."
      },
      {
        "sourceStepIndices": [
          8
        ],
        "summaryAr": "اخبزي ساعة إلى ساعة ونصف حتى يتماسك الكيك، واختبريه بعود نظيف."
      },
      {
        "sourceStepIndices": [
          9
        ],
        "summaryAr": "أخرجي القالب واتركيه يبرد تماماً على شبك."
      },
      {
        "sourceStepIndices": [
          10
        ],
        "summaryAr": "برّديه عدة ساعات أو ليلة كاملة."
      },
      {
        "sourceStepIndices": [
          11
        ],
        "summaryAr": "اقلبيه على طبق بحافة لاحتواء الشراب وقدميه."
