      "steps": [
        {
          "textAr": "سخن الفرن180م؛ اعجن اللحم والخضرة والبصل والثوم مع البهار والملح، وشكله كرات.",
          "evidenceUrl": "https://www.manalonline.com/كفتة-بالطحينة/",
          "sourceStepIndices": [
            0,
            1,
            2
          ]
        },
        {
          "textAr": "سخن الزيت واقلِ الصنوبر ثم الكفتة للتحمير وانقلها لطبق؛ أضف زيت الصلصة وبصلها للمقلاة حتى يذبل وأبعدها.",
          "evidenceUrl": "https://www.manalonline.com/كفتة-بالطحينة/",
          "sourceStepIndices": [
            3,
            4,
            5
          ]
        },
        {
          "textAr": "اخلط بقية الصلصة، وأضفها للبصل ثم الكفتة؛ اخبز20دقيقة حتى النضج وتكثف الصلصة وزيّن.",
          "evidenceUrl": "https://www.manalonline.com/كفتة-بالطحينة/",
