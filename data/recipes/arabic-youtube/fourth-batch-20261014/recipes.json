      "steps": [
        {
          "textAr": "اغسل الأرز وانقعه30دقيقة وقطع الدجاج؛ سخن الدهن وحمّر البصل، واحفظ ملعقة كبيرة للتزيين.",
          "evidenceUrl": "https://www.manalonline.com/كبسة-الدجاج-السريعة/",
          "sourceStepIndices": [
            0,
            1,
            2,
            3
          ]
        },
        {
          "textAr": "حمّر الدجاج بقوة؛ أضف الطماطم ومعجونها وبقية المنكهات؛ صب5أكواب ماء وغطّ واطه30دقيقة بنار متوسطة.",
          "evidenceUrl": "https://www.manalonline.com/كبسة-الدجاج-السريعة/",
          "sourceStepIndices": [
            4,
            5,
            6
          ]
        },
        {
          "textAr": "أضف الأرز المصفّى؛ اتركه يغلي دقائق ثم غطّه وخفف النار50دقيقة حسب المصدر؛ قدّم بالبصل المحفوظ.",
          "evidenceUrl": "https://www.manalonline.com/كبسة-الدجاج-السريعة/",
          "sourceStepIndices": [
            7,
            8
          ]
        }
      ],
      "unknowns": [
        "وزن الدجاج والحصص وحرارة النضج مجهولة.",
        "50دقيقة للأرز كما نشرها المصدر؛ ليست مدة مختبرة.",
        "اختيار السمن أو الزيت يتطلب قرارًا صريحًا."
