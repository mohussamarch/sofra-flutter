          "id": "fi650-52472-i6"
        }
      ],
      "steps": [
        {
          "n": 1,
          "text": "أزيلي سيقان البقدونس والنعناع، واشطفي الأوراق في مصفاة ثم جففيها بورق المطبخ.",
          "duration": null,
          "passive": false
        },
        {
          "n": 2,
          "text": "افرمي البقدونس والنعناع نبضيًا في محضرة الطعام حتى ينعما، ثم انقليهما إلى وعاء كبير.",
          "duration": null,
          "passive": false
        },
        {
          "n": 3,
          "text": "أضيفي البصل الأخضر والطماطم والبرغل المطبوخ وقلّبي.",
          "duration": null,
          "passive": false
        },
        {
          "n": 4,
          "text": "أضيفي عصير الليمون وزيت الزيتون وقلّبي، ثم ضعيها في الثلاجة ساعة قبل التقديم.",
          "duration": null,
          "passive": false
        },
        {
          "n": 5,
          "text": "قدّميها وحدها أو مع الخبز العربي. يذكر المصدر أنها تكفي حصتين.",
          "duration": null,
          "passive": false
        }
      ],
      "tags": [],
      "notes": "المصدر: https://www.foodista.com/recipe/JM4J3HC6/lebanese-tabouleh؛ CC BY كما يصرح المصدر، ترجمة عربية وتوضيح المقادير فقط. بصمة لقطة المصدر: b24cad4249477468b1289e70ff0e6af05a4808cab0808ac646f6b610769b6872؛ Common Pile revision 4fd174745182885bea01d47c8ba71b1946375898؛ المردود2 منشور صراحة في الطريقة. ساعة التبريد محفوظة ولا تُعامل كزمن إجمالي أو زمن تحضير معلوم. عبارة bushel غير متسقة مع3أكواب؛ لا تحويل منها. التغذية والحساسية وربط المخزون غير معتمدين تلقائيًا."
