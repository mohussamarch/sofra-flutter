    {
      "id": "fiw650-50609",
      "name": "فتات التفاح البريطاني التقليدي",
      "nameEn": "Traditional British Apple Crumble",
      "cuisine": "بريطاني",
      "category": "حلويات",
      "description": "تفاح مطهو يغطى بفتات الدقيق والزبدة والسكر ويخبز حتى يذهب لونه إلى الذهبي.",
      "difficulty": "غير محدد بالمصدر",
      "servings": null,
      "prepTime": null,
      "cookTime": 40,
      "totalTime": null,
      "metadataPolicy": "source-unknowns-v1",
      "ingredients": [
        {
          "name": "دقيق عادي منخول",
          "amount": 8,
          "unit": "أونصات",
          "scale": true,
          "optional": false,
          "note": "225 غراماً بحسب المصدر"
        },
        {
          "name": "زبدة بدرجة حرارة الغرفة مقطعة",
          "amount": 4,
          "unit": "أونصات",
          "scale": true,
          "optional": false,
          "note": "يذكر السطر أيضاً 110 غراماً كتحويل، ونحافظ على التعارض النصي"
        },
        {
          "name": "سكر",
          "amount": 3,
          "unit": "أونصات",
          "scale": true,
          "optional": false,
          "note": null
        },
        {
          "name": "تفاح مقشر ومنزوع القلب",
          "amount": 1,
          "unit": "رطل",
          "scale": true,
          "optional": false,
          "note": "يورد المصدر 500 غرام أيضاً؛ صنف Bramley مقترح وليس ضرورياً"
        },
        {
          "name": "سكر إضافي للتفاح",
          "amount": null,
          "unit": null,
          "scale": false,
          "optional": true,
          "note": "2/3 ملاعق كبيرة بحسب المصدر؛ وحدة/عدد غير محكم، اختياري مع التفاح العادي"
        },
        {
          "name": "ماء للتفاح",
          "amount": 3,
          "unit": "ملعقة كبيرة",
          "scale": true,
          "optional": false,
          "note": "مذكور في الطريقة لا القائمة"
        }
      ],
      "steps": [
        {
          "n": 1,
          "text": "سخّن الفرن إلى علامة الغاز 4/350°F/180°C. ضع الدقيق والزبدة والسكر في محضرة الطعام واخلط حتى يشبه الخليط الفتات. إن لم تتوفر محضرة، ضع الدقيق في وعاء كبير وافرك الزبدة فيه بخفة بأطراف الأصابع. عندما يصبح مفتتاً أضف السكر وامزج جيداً. قشر التفاح وانزع قلبه وضعه في قدر مع السكر الاختياري وثلاث ملاعق كبيرة ماء، وسخنه على نار معتدلة حتى يلين ويصبح مهروساً قليلاً. ضع التفاح المطهو في طبق فرن وانثر فوقه خليط الفتات. اخبز 40 دقيقة حتى يصبح السطح ذهبياً. قدّم مع الكريمة أو الكاسترد.",
          "duration": null,
          "passive": false
        }
      ],
      "tags": [
        "تفاح"
      ],
      "notes": "المصدر: https://www.foodista.com/recipe/HF5B3JNF/traditional-british-apple-crumble — SHA-256: 595d01dca333ed433e9a8d4da23a7f2b13357d44822f721ea63d7e94922fb3a3 — أزيلت عناوين الأقسام وتعليمة تسخين الفرن من قائمة المكونات؛ أضيفت 3 ملاعق كبيرة ماء المذكورة في الطريقة، وحُفظت كمية السكر الاختيارية المبهمة دون تحويل."
    },
