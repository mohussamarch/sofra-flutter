      "supplementalIngredients": [],
      "steps": [
        {
          "n": 1,
          "textAr": "اخلط الطماطم والكريمة والسكر والفلفل الأبيض والملح والثوم والكايين في الخلاط حتى تنعم؛ اعمل على دفعات عند الحاجة.",
          "sourceStepIndices": [
            0
          ],
          "duration": null
        },
        {
          "n": 2,
          "textAr": "انقل الخليط إلى قدر وارفعه إلى الغليان على نار عالية.",
          "sourceStepIndices": [
            1
          ],
          "duration": null
        },
        {
          "n": 3,
          "textAr": "خفف الحرارة واترك الشوربة تغلي بهدوء 20–30 دقيقة مع التقليب أحيانًا حتى تثخن.",
          "sourceStepIndices": [
            2
          ],
          "duration": {
            "min": 20,
            "max": 30,
            "scope": "simmering"
          }
        },
        {
          "n": 4,
          "textAr": "قدمها ساخنة دون إضافات التزيين المقترحة.",
          "sourceStepIndices": [
            3
          ],
          "duration": null
        }
      ],
      "excludedSourceSteps": [],
      "notes": [
        "الروبيان والسجق المقترحان للتزيين مستبعدان من هذه الصيغة.",
        "الساعة هي الزمن الإجمالي المنشور؛ لا تخمن مدة التحضير من طرح نطاق الغليان. لا تدعي ملاءمة صحية من اسم الوصفة."
      ],
      "blockers": [
        "فصل التحضير والطهي وعدة مدد خطوات غير منشور",
        "طماطم طازجة/معلبة وأساس الكريمة وقياسات الأكواب تحتاج ربطًا صريحًا قبل التغذية",
        "معرفات المخزون وروابط الغذاء والحقوق الفردية غير معتمدة"
      ],
