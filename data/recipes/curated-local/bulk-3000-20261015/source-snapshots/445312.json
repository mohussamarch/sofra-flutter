\n\n== Procedure ==\n\n# Butcher and skin the iguanas. Cut into pieces.\n# Wash and salt the iguana pieces. [[Cookbook:Boiling|Boil]] in water for 15–20 minutes.\n# [[Cookbook:Simmering|Simmer]] the corn, garlic, onion, bay leaf, and salt to taste. After 10 minutes, add the meat. Cook for another 15–20 minutes.\n# Serve with sliced cabbage, sliced onion, cilantro, oregano, and pepper to taste.\n\n== References ==\nMartinez Campos - ''Recetario'' (p. 42)\n\n[[Category:Recipes using iguana]]\n[[Category:Recipes using bay leaf]]\n[[Category:Recipes using cabbage]]\n[[Category:Recipes using hominy]]","isRecipe":true,"recipe":{"name":"Iguana Pozole","nameAr":null,"servings":null,"servingsSourceText":null,"ingredients":[{"id":"source-line-1","name":"2 medium iguanas","sourceText":"2 medium iguanas","amountText":"2 medium iguanas","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-2","name":"5 cups freshly-bleached hominy","sourceText":"5 cups freshly-bleached hominy","amountText":"5 cups freshly-bleached hominy","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-3","name":"10 cloves of garlic","sourceText":"10 cloves of garlic","amountText":"10 cloves of garlic","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-4","name":"1 onion","sourceText":"1 onion","amountText":"1 onion","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-5","name":"1 slice of cabbage, diced","sourceText":"1 slice of cabbage, diced","amountText":"1 slice of cabbage, diced","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-6","name":"Bay leaf","sourceText":"Bay leaf","amountText":"Bay leaf","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-7","name":"Mexican oregano","sourceText":"Mexican oregano","amountText":"Mexican oregano","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-8","name":"Salt","sourceText":"Salt","amountText":"Salt","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-9","n