ook:Salt|Salt]], to taste\n\n== Procedure ==\n#Peel and cut the mango into small pieces. Mix with salt and set aside.\n#Grind the coconut with water and 2 of the dried chilies until well-blended.\n#Add the coconut-chili mixture to the mango, and mix well.\n#Heat oil in a [[Cookbook:Kadai|kadai]]; add the mustard and remaining dried chilies, and [[Cookbook:Frying|fry]].\n#Pour into the mango coconut mixture, and cook briefly.\n#Serve with plain [[Cookbook:Rice|rice]].\n\n[[Category:Recipes for sauces and condiments]]\n[[Category:Recipes using coconut]]\n[[Category:Recipes using mango]]\n[[Category:Recipes using chile]]","isRecipe":true,"recipe":{"name":"Kerala Pachadi (Coconut Mango Condiment)","nameAr":null,"servings":null,"servingsSourceText":null,"ingredients":[{"id":"source-line-1","name":"1 ripe mango","sourceText":"1 ripe mango","amountText":"1 ripe mango","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-2","name":"½ cup coconut flesh","sourceText":"½ cup coconut flesh","amountText":"½ cup coconut flesh","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-3","name":"¼ cup water","sourceText":"¼ cup water","amountText":"¼ cup water","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-4","name":"4 dried chiles","sourceText":"4 dried chiles","amountText":"4 dried chiles","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-5","name":"1 tablespoon oil","sourceText":"1 tablespoon oil","amountText":"1 tablespoon oil","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-6","name":"¼ teaspoon mustard","sourceText":"¼ teaspoon mustard","amountText":"¼ teaspoon mustard","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-7","name":"Salt, to taste","sourceText":"Salt, to taste","amountText":"Salt, to taste","amount":null,"unit":null,"foodBinding":null}],"steps":[{"n":1,"text":"Peel and cut the mango into small pieces. Mix with salt and set aside.","sourceText":"Peel and cut the mango into small