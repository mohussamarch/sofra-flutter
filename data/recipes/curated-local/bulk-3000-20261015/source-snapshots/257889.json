t\n* [[Cookbook:Pepper|Pepper]]\n* Dried [[Cookbook:Mint|mint]]\n\n==Procedure==\n\n# [[Cookbook:Chopping|Chop]] the cucumbers, tomatoes, and onions finely.\n# [[Cookbook:Marinating|Marinate]] them in lemon juice or vinegar.\n# Add salt and pepper. Sprinkle with the dried mint.\n\n\n[[Category:Recipes for salad]]\n[[Category:Recipes using lemon juice]]\n[[Category:Recipes using onion]]\n[[Category:Recipes using cucumber]]\n[[Category:Recipes using tomato]]\n[[Category:Recipes using mint]]","isRecipe":true,"recipe":{"name":"Salad Shirazi","nameAr":null,"servings":null,"servingsSourceText":null,"ingredients":[{"id":"source-line-1","name":"Cucumber","sourceText":"Cucumber","amountText":"Cucumber","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-2","name":"Onions","sourceText":"Onions","amountText":"Onions","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-3","name":"Tomatoes","sourceText":"Tomatoes","amountText":"Tomatoes","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-4","name":"Lemon juice or vinegar","sourceText":"Lemon juice or vinegar","amountText":"Lemon juice or vinegar","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-5","name":"Salt","sourceText":"Salt","amountText":"Salt","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-6","name":"Pepper","sourceText":"Pepper","amountText":"Pepper","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-7","name":"Dried mint","sourceText":"Dried mint","amountText":"Dried mint","amount":null,"unit":null,"foodBinding":null}],"steps":[{"n":1,"text":"Chop the cucumbers, tomatoes, and onions finely.","sourceText":"Chop the cucumbers, tomatoes, and onions finely.","durationMinutes":null},{"n":2,"text":"Marinate them in lemon juice or vinegar.","sourceText":"Marinate them in lemon juice or vinegar.","durationMinutes":null},{"n":3,"text":"Add salt and pepper. Sprinkle with the dried mint.","sourceText":"Add salt and pepper. Sprinkle with the dri