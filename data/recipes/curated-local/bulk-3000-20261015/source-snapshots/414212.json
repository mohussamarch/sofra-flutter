 recipes]]\n[[Category:Recipes using superfine sugar]]\n[[Category:Recipes using lemon juice]]\n[[Category:Recipes using strawberry]]\n[[Category:Recipes using yogurt]]\n[[Category:Recipes using ice cream]]","isRecipe":true,"recipe":{"name":"Strawberry-Vanilla Lassi","nameAr":null,"servings":null,"servingsSourceText":null,"ingredients":[{"id":"source-line-1","name":"10 strawberries","sourceText":"10 strawberries","amountText":"10 strawberries","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-2","name":"4 tbsp superfine sugar","sourceText":"4 tbsp superfine sugar","amountText":"4 tbsp superfine sugar","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-3","name":"1 pack vanilla sugar","sourceText":"1 pack vanilla sugar","amountText":"1 pack vanilla sugar","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-4","name":"4 scoops vanilla ice cream","sourceText":"4 scoops vanilla ice cream","amountText":"4 scoops vanilla ice cream","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-5","name":"150 ml water","sourceText":"150 ml water","amountText":"150 ml water","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-6","name":"1 tbsp lemon juice","sourceText":"1 tbsp lemon juice","amountText":"1 tbsp lemon juice","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-7","name":"200 g yogurt","sourceText":"200 g yogurt","amountText":"200 g yogurt","amount":null,"unit":null,"foodBinding":null}],"steps":[{"n":1,"text":"Put everything in a blender, and blend until smooth.","sourceText":"Put everything in a blender, and blend until smooth.","durationMinutes":null}],"nutrition":null,"gaps":["Research extraction only; no culinary/editorial review.","Ingredient quantities, units, alternatives, food identities, aggregate duration, and nutrition remain unknown until individually parsed/reviewed.","Source-level CC BY-SA policy applies generally; page-specific exceptions have not been checked."]}},"parsedRecip