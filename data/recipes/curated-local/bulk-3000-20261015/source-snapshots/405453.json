]] (optional)\n\n==Procedure==\n#Combine shredded chicken, apricots, apple and celery.\n#Add yogurt, honey, and hot paprika powder, along with any other desired seasonings.\n#Mix well.\n\n[[Category:Recipes using apple]]\n[[Category:Recipes for salad]]\n[[Category:Recipes using celery]]\n[[Category:Recipes using apricot]]\n[[Category:Recipes using chicken]]\n[[Category:Recipes using honey]]","isRecipe":true,"recipe":{"name":"Apricot Chicken Salad","nameAr":null,"servings":null,"servingsSourceText":null,"ingredients":[{"id":"source-line-1","name":"Shredded cooked chicken (about 2 small drumsticks)","sourceText":"Shredded cooked chicken (about 2 small drumsticks)","amountText":"Shredded cooked chicken (about 2 small drumsticks)","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-2","name":"1 stalk celery, chopped","sourceText":"1 stalk celery, chopped","amountText":"1 stalk celery, chopped","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-3","name":"1 medium apple, finely chopped","sourceText":"1 medium apple, finely chopped","amountText":"1 medium apple, finely chopped","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-4","name":"1 tbsp honey","sourceText":"1 tbsp honey","amountText":"1 tbsp honey","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-5","name":"3 dried apricots, chopped","sourceText":"3 dried apricots, chopped","amountText":"3 dried apricots, chopped","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-6","name":"Strained plain yogurt","sourceText":"Strained plain yogurt","amountText":"Strained plain yogurt","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-7","name":"Hot paprika (optional)","sourceText":"Hot paprika (optional)","amountText":"Hot paprika (optional)","amount":null,"unit":null,"foodBinding":null}],"steps":[{"n":1,"text":"Combine shredded chicken, apricots, apple and celery.","sourceText":"Combine shredded chicken, apricots, apple and celery.","duration