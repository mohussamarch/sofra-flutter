d]]\n* 1 [[Cookbook:Tablespoon|tbsp]] extra-virgin [[Cookbook:Olive Oil|olive oil]]\n\n== Procedure ==\n#Sprinkle mushrooms and onion with salt and black pepper.\n#Heat oil in large [[Cookbook:Sauté Pan|sauté pan]] over medium high heat.\n#Add garlic and cook 30–45 seconds. Add remaining ingredients and cook for 7–10 more minutes.\n#Remove from pan and drizzle with pan juices. Serve.\n\n[[Category:Recipes using morel]]\n[[Category:Recipes for sauces and condiments]]\n[[Category:Pan fried recipes]]\n[[Category:Side dish recipes]]\n[[Category:Sautéed recipes]]","isRecipe":true,"recipe":{"name":"Sauteed Morels","nameAr":null,"servings":null,"servingsSourceText":null,"ingredients":[{"id":"source-line-1","name":"1 pound morel mushrooms, thinly sliced","sourceText":"1 pound morel mushrooms, thinly sliced","amountText":"1 pound morel mushrooms, thinly sliced","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-2","name":"Salt","sourceText":"Salt","amountText":"Salt","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-3","name":"Black pepper","sourceText":"Black pepper","amountText":"Black pepper","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-4","name":"2 tsp minced garlic","sourceText":"2 tsp minced garlic","amountText":"2 tsp minced garlic","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-5","name":"½ large onion, diced","sourceText":"½ large onion, diced","amountText":"½ large onion, diced","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-6","name":"1 tbsp extra-virgin olive oil","sourceText":"1 tbsp extra-virgin olive oil","amountText":"1 tbsp extra-virgin olive oil","amount":null,"unit":null,"foodBinding":null}],"steps":[{"n":1,"text":"Sprinkle mushrooms and onion with salt and black pepper.","sourceText":"Sprinkle mushrooms and onion with salt and black pepper.","durationMinutes":null},{"n":2,"text":"Heat oil in large sauté pan over medium high heat.","sourceText":"Heat oil in large sauté pan