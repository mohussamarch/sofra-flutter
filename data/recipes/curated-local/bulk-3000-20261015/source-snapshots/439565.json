== Ingredients ==\n\n* ¾ cup [[Cookbook:Butter|butter]]\n* 2 cups white granulated [[Cookbook:Sugar|sugar]]\n* 1 cup [[Cookbook:Milk|milk]]\n* 3 cups [[Cookbook:Flour|flour]]\n* 2 [[Cookbook:Egg|eggs]]\n* 2 tsp [[Cookbook:Cream of Tartar|cream of tartar]]\n* 1 tsp [[Cookbook:Baking Soda|baking soda]]\n* Sugar\n* Ground [[Cookbook:Cinnamon|cinnamon]]\n\n== Procedure ==\n\n# [[Cookbook:Creaming|Cream]] the butter and sugar together.\n# [[Cookbook:Beating|Beat]] in the eggs.\n# Combine the flour, cream of tartar, and baking soda.\n# Alternately mix the flour and milk into the batter to make a [[Cookbook:Dough|dough]].\n# Drop dough on a greased or lined baking sheet in spoonfuls.\n# Sprinkle with sugar and cinnamon.\n# Bake in a [[Cookbook:Oven Temperatures|quick]] [[Cookbook:Oven|oven]].\n\n== See also ==\n\n* [[Cookbook:Snickerdoodles|Snickerdoodles]]\n\n[[Category:Recipes for snickerdoodles]]\n[[Category:Recipes using butter]]\n[[Category:Dessert recipes]]\n[[Category:Recipes using baking soda]]\n[[Category:Recipes using white sugar]]\n[[Category:Recipes using ground cinnamon]]\n[[Category:Recipes using cream of tartar]]\n[[Category:Recipes using egg]]\n[[Category:Recipes using wheat flour]]\n[[Category:Recipes using cow milk]]","isRecipe":true,"recipe":{"name":"Snickerdoodles (Boston Globe)","nameAr":null,"servings":null,"servingsSourceText":null,"ingredients":[{"id":"source-line-1","name":"¾ cup butter","sourceText":"¾ cup butter","amountText":"¾ cup butter","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-2","name":"2 cups white granulated sugar","sourceText":"2 cups white granulated sugar","amountText":"2 cups white granulated sugar","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-3","name":"1 cup milk","sourceText":"1 cup milk","amountText":"1 cup milk","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-4","name":"3 cups flour","sourceText":"3 cups flour","amountText":"3 cups flour","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-5","name":"2 eggs","sourceText":"2 eggs","amountText":"2 eggs","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-6","name":"2 tsp cream of tartar","sourceText":"2 tsp cream of tartar","amountText":"2 tsp cream of tartar","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-7","name":"1 tsp baking soda","sourceText":"1 tsp baking soda","amountText":"1 tsp baking soda","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-8","name":"Sugar","sourceText":"Sugar","amountText":"Sugar","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-9","name":"Ground cinnamon","sourceText":"Ground cinnamon","amountText":"Ground cinnamon","amount":null,"unit":null,"foodBinding":null}],"steps":[{"n":1,"text":"Cream the butter and sugar together.","sourceText":"Cream the butter and sugar together.","durationMinutes":null},{"n":2,"text":"Beat in the eggs.","sourceText":"Beat in the eggs.","durationMinutes":null},{"n":3,"text":"Combine the flour, cream of tartar, and baking soda.","sourceText":"Combine the flour, cream of tartar, and baking soda.","durationMinutes":null},{"n":4,"text":"Alternately mix the flour and milk into the batter to make a dough.","sourceText":"Alternately mix the flour and milk into the batter to make a dough.","durationMinutes":null},{"n":5,"text":"Drop dough on a greased or lined baking sheet in spoonfuls.","sourceText":"Drop dough on a greased or lined baking sheet in spoonfuls.","durationMinutes":null},{"n":6,"text":"Sprinkle with sugar and cinnamon.","sourceText":"Sprinkle with sugar and cinnamon.","durationMinutes":null},{"n":7,"text":"Bake in a quick oven.","sourceText":"Bake in a quick oven.","durationMinutes":null}],"nutrition":null,"gaps":["Research extraction only; no culinary/editorial review.","Ingredient quantities, units, alternatives, food identities, aggregate duration, and nutrition remain unknown until individually parsed/reviewed.","Source-level CC BY-SA policy app