ine vinegar|wine vinegar]]\n* 6 tbsp extra-virgin [[Cookbook:Olive Oil|olive oil]]\n* 2 [[Cookbook:Teaspoon|tsp]] [[Cookbook:Dijon Mustard|Dijon mustard]]\n* [[Cookbook:Salt|Salt]], to taste\n* [[Cookbook:Pepper|Pepper]], to taste\n\n== Procedure ==\n#[[Cookbook:Whisk|Whisk]] together vinegar and mustard.\n#Slowly stream in oil while whisking continuously.\n#Taste and check for seasoning; adjust as desired.\n#[[Cookbook:Tossing|Toss]] with salad greens and serve.","isRecipe":true,"recipe":{"name":"Basic Vinaigrette","nameAr":null,"servings":null,"servingsSourceText":null,"ingredients":[{"id":"source-line-1","name":"2 tbsp red wine vinegar","sourceText":"2 tbsp red wine vinegar","amountText":"2 tbsp red wine vinegar","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-2","name":"6 tbsp extra-virgin olive oil","sourceText":"6 tbsp extra-virgin olive oil","amountText":"6 tbsp extra-virgin olive oil","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-3","name":"2 tsp Dijon mustard","sourceText":"2 tsp Dijon mustard","amountText":"2 tsp Dijon mustard","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-4","name":"Salt, to taste","sourceText":"Salt, to taste","amountText":"Salt, to taste","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-5","name":"Pepper, to taste","sourceText":"Pepper, to taste","amountText":"Pepper, to taste","amount":null,"unit":null,"foodBinding":null}],"steps":[{"n":1,"text":"Whisk together vinegar and mustard.","sourceText":"Whisk together vinegar and mustard.","durationMinutes":null},{"n":2,"text":"Slowly stream in oil while whisking continuously.","sourceText":"Slowly stream in oil while whisking continuously.","durationMinutes":null},{"n":3,"text":"Taste and check for seasoning; adjust as desired.","sourceText":"Taste and check for seasoning; adjust as desired.","durationMinutes":null},{"n":4,"text":"Toss with salad greens and serve.","sourceText":"Toss with salad greens and serve.","duratio