it":null,"foodBinding":null},{"id":"source-line-6","name":"¼ cup molasses","sourceText":"¼ cup molasses","amountText":"¼ cup molasses","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-7","name":"3 drops liquid smoke","sourceText":"3 drops liquid smoke","amountText":"3 drops liquid smoke","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-8","name":"2 tbsp cider vinegar","sourceText":"2 tbsp cider vinegar","amountText":"2 tbsp cider vinegar","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-9","name":"2 tbsp white wine","sourceText":"2 tbsp white wine","amountText":"2 tbsp white wine","amount":null,"unit":null,"foodBinding":null}],"steps":[{"n":1,"text":"Combine cayenne, salt, and pepper, and toss with wings. Refrigerate.","sourceText":"Combine cayenne, salt, and pepper, and toss with wings. Refrigerate.","durationMinutes":null},{"n":2,"text":"Combine sauce ingredients. Heat in a microwave until warm and well mixed. Allow to cool.","sourceText":"Combine sauce ingredients. Heat in a microwave until warm and well mixed. Allow to cool.","durationMinutes":null},{"n":3,"text":"Brush wings on all sides with about ¾ of the sauce (or just put ¾ of the sauce in a ziplock with the wings) and refrigerate as long as possible.","sourceText":"Brush wings on all sides with about ¾ of the sauce (or just put ¾ of the sauce in a ziplock with the wings) and refrigerate as long as possible.","durationMinutes":null},{"n":4,"text":"Grill until internal temperature reaches 165 °F.","sourceText":"Grill until internal temperature reaches 165 °F.","durationMinutes":null},{"n":5,"text":"Remove to a plate and cover. Let rest 5 minutes before serving with the remaining ¼ of the sauce.","sourceText":"Remove to a plate and cover. Let rest 5 minutes before serving with the remaining ¼ of the sauce.","durationMinutes":null}],"nutrition":null,"gaps":["Research extraction only; no culinary/editorial review.","Ingredient quantities, units, alternatives, food