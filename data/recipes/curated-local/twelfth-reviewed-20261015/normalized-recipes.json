      "steps": [
        {
          "n": 1,
          "textAr": "ضعي البصل المفروم في قدر كبير مع4ملاعق كبيرة زيت الزيتون.",
          "sourceStepIndices": [
            0
          ],
          "duration": null
        },
        {
          "n": 2,
          "textAr": "شوّحي البصل على نار منخفضة حتى يشفّ ويصبح ذهبيًا قليلًا.",
          "sourceStepIndices": [
            1
          ],
          "duration": null
        },
        {
          "n": 3,
          "textAr": "أضيفي8أكواب الماء والعدس والكمون والكزبرة؛ تذكر الخطوة الأصلية خليط الشوربة، بينما بديله مع الملح وحذفه ما زال يحتاج اختيارًا.",
          "sourceStepIndices": [
            2
          ],
          "duration": null
        },
        {
          "n": 4,
          "textAr": "قلّبي وارفعِي الحرارة إلى المتوسطة تقريبًا ليظهر غليان خفيف دون غليان شديد.",
          "sourceStepIndices": [
            3
          ],
          "duration": null
        },
        {
          "n": 5,
          "textAr": "اتركي الخليط على غليان هادئ ساعة مع التقليب كل بضع دقائق وضبط الحرارة؛ تذوقي وأضيفي الملح عند الحاجة بحسب اختيار المكوّن.",
          "sourceStepIndices": [
            4
          ],
          "duration": {
            "min": 60,
            "max": 60,
            "scope": "simmer",
            "approximate": false
          }
        },
        {
          "n": 6,
          "textAr": "أطفئي الموقد وانقلي القدر إلى موقد آخر حتى لا يستمر الطهي.",
          "sourceStepIndices": [
            5
          ],
          "duration": null
        },
        {
          "n": 7,
          "textAr": "اقطعي الليمونة نصفين واعصريها.",
          "sourceStepIndices": [
            6
          ],
          "duration": null
        },
        {
          "n": 8,
          "textAr": "أضيفي عصير الليمون إلى القدر وقلّبي.",
          "sourceStepIndices": [
            7
          ],
          "duration": null
        },
        {
          "n": 9,
          "textAr": "تذوقي وقدّمي؛ يذكر المصدر إمكانية إضافة كمون وليمون طازج إضافيين حسب التفضيل.",
          "sourceStepIndices": [
            8
          ],
          "duration": null
        }
      ],
      "excludedSourceSteps": [],
      "notes": [
        "الناتج4حصص، والتحضير20دقيقة والطهي ساعة منشوران؛ لا يوجد مجموع منشور ولا زمن مقاس فعليًا، فلا ننتج80دقيقة كحقيقة مصدرية.",
        "القائمة تسمح بملح أو4ملاعق خليط شوربة أوحذفه، لكن الخطوة3تذكر خليط الشوربة ثم تضيف الملح عند الحاجة؛ لم يُحسم الاختيار أو هوية الخليط.",
        "المصدر يسميها يخنة عدس مصرية ويذكر اسم shorbat ads بمعنى حساء عدس؛ لا يثبت ذلك تطابقها مع وصفة كتالوج أخرى أو اختلاف طريقة معتمد.",
        "تصنيف Category:Egyptian recipes دليل المصدر، وليس اعتماد مطبخ وطني أو وصفة سريرية."
      ],
      "blockers": [
        "اختيار الملح/خليط الشوربة وكميته وهوية الخليط والكوب والرطل والتزيين يحتاج مراجعة قبل التحجيم أو الحساب."
