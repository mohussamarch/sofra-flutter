      }
    ],
    "steps": [
      {
        "text": "1 Mix soup and sour cream together. Put hash browns in bowl and add soup mixture. Mix well. Pour into 9x11 dish. Sprinkle topping over top. Bake at 350 degrees for 45 minutes or until bubbly."
