        "sourceText": "1 (No. 2) can crushed pineapple"
      },
      {
        "sourceText": "2 tablespoons cornstarch"
      },
      {
        "sourceText": "1/2 cup sugar"
      },
      {
        "sourceText": "1/4 teaspoon salt"
      },
      {
        "sourceText": "1 tablespoon butter"
      },
      {
        "sourceText": "1 tablespoon lemon juice"
      }
    ],
    "steps": [
      {
        "text": "1 Cook first 4 ingredients until thick. Add butter and lemon juice. Cool slightly and pour into a baked pie shell and cool. Top with whipped cream."
      }
