        "sourceText": "2 cups oil"
      },
      {
        "sourceText": "4 cups warm water"
      },
      {
        "sourceText": "5 pounds flour"
      },
      {
        "sourceText": "1/2 block of cake yeast"
      }
    ],
    "steps": [
      {
        "text": "1 Dissolve yeast in warm water. Add oil to flour and blend thoroughly. Add water to flour mixture and knead until smooth. Make dough for 8 large pizzas. Can be frozen and used at your convenience."
