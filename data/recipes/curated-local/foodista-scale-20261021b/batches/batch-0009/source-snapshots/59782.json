      },
      {
        "sourceText": "1 1/2 teaspoons Cornstarch"
      },
      {
        "sourceText": "1/2 cup Boysenberry Jam"
      }
    ],
    "steps": [
      {
        "text": "1 Thaw and crush frozen berries. Combine with cornstarch. Add jam. Heat to boiling. Cook and stir until clear and slightly thick. Strain and cool."
