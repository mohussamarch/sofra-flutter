      },
      {
        "sourceText": "3 teaspoons chopped onion"
      },
      {
        "sourceText": "1 teaspoon chopped mint"
      },
      {
        "sourceText": "1 teaspoon lemon juice"
      }
    ],
    "steps": [
      {
        "text": "1 Slowly heat oil in crockpot. Add chops; brown on both sides. Add remaining ingredients with 1/4 cup water. Simmer, cover 40 minutes or until chops are tender. Serves 4."
