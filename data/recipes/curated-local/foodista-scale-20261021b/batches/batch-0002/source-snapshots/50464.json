        "sourceText": "4 Japanese cucumbers thinly sliced"
      },
      {
        "sourceText": "1 Red onion, thinly sliced"
      },
      {
        "sourceText": "1/2 cup Rice vinegar"
      },
      {
        "sourceText": "2 teaspoons Rice syrup"
      },
      {
        "sourceText": "1/4 teaspoon Salt"
      },
      {
        "sourceText": "3 Fresh red chili peppers seeded"
      },
      {
        "sourceText": "2 tablespoons Fresh cilantro"
      }
    ],
    "steps": [
      {
        "text": "1 Combine all ingredients and refrigerate. Serve as a compliment to grilled or spicy foods, or with chicken or fish. 2 Store in a Japanese pickle press."
