      },
      {
        "sourceText": "1 teaspoon Oregano"
      },
      {
        "sourceText": "1 teaspoon Italian seasonings"
      },
      {
        "sourceText": "1 teaspoon Chopped parsley"
      }
    ],
    "steps": [
      {
        "text": "1 Grind the anise seeds. Mix together all ingredients. Spread on your favorite pizza crust or dough."
      },
      {
        "text": "Top with veggies and whatever other toppings you are using."
