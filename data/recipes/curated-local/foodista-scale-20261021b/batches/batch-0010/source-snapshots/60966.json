      },
      {
        "sourceText": "3 star anises"
      },
      {
        "sourceText": "1 lemon juiced"
      }
    ],
    "steps": [
      {
        "text": "1 Cook all ingredients in boiling water; turn to simmer for 55 to an hour until all liquid are gone. 2 Add lemon juice and mix well.  Ready to serve, enjoy!"
