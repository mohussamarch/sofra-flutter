king oil","amount":null,"unit":null,"foodBinding":null,"quantityCandidate":{"sourceText":"2 tbsp cooking oil","parserVersion":"source-prefix-v2","status":"parsed-source-candidate","amount":2,"unit":"tbsp","quantityText":"2","unitText":"tbsp","remainingText":"cooking oil","reason":"spoon-volume-system-unspecified","reviewStatus":"unreviewed-source-transcription","canonicalAmount":null,"canonicalUnit":null,"foodBinding":null},"sourceStructure":{"parserVersion":"source-structure-v1","reviewStatus":"source-cues-unreviewed","sourceGroupPath":[{"level":3,"title":"Soup","sourceHeading":"=== Soup ==="}],"optionalityCue":null,"alternativeCue":null,"quantityQualifier":null,"alternatives":null,"selectedAlternative":null,"optional":null}}],"steps":[{"n":1,"text":"Grind the ingredients for the spice paste together in a food processor. Stir fry the spice paste over slow fire until fragrant. Remove from the heat.","durationMinutes":null},{"n":2,"text":"Make soup by cooking the whole chicken with spice paste, galangal, lime leaves, lemon grass, and bay leaves in a pot for at least 30 minutes until the meat is tender. Use a pressure cooker for faster cooking time and better broth. For a traditional method, bring soup to boil, cover, and turn off heat, then let steep for 30–40 minutes—this makes the meat more tender.","durationMinutes":null},{"n":3,"text":"Add a little bit of salt or pepper to taste.","durationMinutes":null},{"n":4,"text":"Leave the chicken in a pot until the soup is cool.","durationMinutes":null},{"n":5,"text":"Remove the meat from the bones, and slice the meat into tiny bit size using fork and knife, then set aside.","durationMinutes":null},{"n":6,"text":"Put back the bones into the soup, add sliced green onion, and bring the soup to the boil right before serving.","durationMinutes":null}],"nutrition":null}},"authoritativeEvidence":{"sourceFileSha256":"93e85705e9141453d5708622c321c17fc793b4fbacfb0663d079fd365e1385d0","parsedRecipesSha256":"b03a74dbe473f11d42d9a7456