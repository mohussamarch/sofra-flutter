gs]]\n* [[cookbook:Sunflower Oil|Sunflower oil]]\n* [[Cookbook:Salt|Salt]]\n* [[Cookbook:Parsley|Parsley]], finely [[Cookbook:Chopping|chopped]]\n\n== Procedure ==\n# [[Cookbook:Roasting|Roast]], peel, and seed the peppers.\n# Mix the crumbled cheese with 4 of the eggs. Stuff the peppers with this mixture.\n# [[Cookbook:Beating|Beat]] the remaining two eggs.\n# Roll the stuffed peppers in breadcrumbs and beaten eggs.\n# [[Cookbook:Frying|Fry]] the breaded peppers in hot oil.\n# Serve sprinkled with finely-chopped parsley.\n\n[[Category:Bulgarian recipes]]\n[[Category:Recipes using red bell pepper]]\n[[Category:Recipes using cheese]]\n[[Category:Recipes using egg]]\n[[Category:Vegetarian recipes]]\n[[Category:Recipes using sunflower oil]]","isRecipe":true,"recipe":{"name":"Red Bell Peppers Stuffed with Cheese and Egg (Chushki Byurek)","nameAr":null,"servings":null,"servingsSourceText":null,"ingredients":[{"id":"source-line-1","name":"1 kg red bell peppers","sourceText":"1 kg red bell peppers","amountText":"1 kg red bell peppers","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-2","name":"250 g brined sheep's cheese","sourceText":"250 g brined sheep's cheese","amountText":"250 g brined sheep's cheese","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-3","name":"6 eggs","sourceText":"6 eggs","amountText":"6 eggs","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-4","name":"Sunflower oil","sourceText":"Sunflower oil","amountText":"Sunflower oil","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-5","name":"Salt","sourceText":"Salt","amountText":"Salt","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-6","name":"Parsley, finely chopped","sourceText":"Parsley, finely chopped","amountText":"Parsley, finely chopped","amount":null,"unit":null,"foodBinding":null}],"steps":[{"n":1,"text":"Roast, peel, and seed the peppers.","sourceText":"Roast, peel, and seed the peppers.","durationMinutes":null},{"n":2