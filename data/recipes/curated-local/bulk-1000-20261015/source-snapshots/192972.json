.","durationMinutes":null},{"n":5,"text":"Deep fry the battered chiles in preheated oil until they turn golden brown.","sourceText":"Deep fry the battered chiles in preheated oil until they turn golden brown.","durationMinutes":null}],"nutrition":null,"gaps":["Research extraction only; no culinary/editorial review.","Ingredient quantities, units, alternatives, food identities, aggregate duration, and nutrition remain unknown until individually parsed/reviewed.","Source-level CC BY-SA policy applies generally; page-specific exceptions have not been checked."]}},"parsedRecipe":{"schemaVersion":1,"id":"wikibooks:192972","recordId":"wikibooks-192972-r4506783","sourceId":"wikibooks-cookbook-cc-by-sa","sourceRevision":"4506783","sourceUrl":"https://en.wikibooks.org/w/index.php?title=Cookbook:Deep%20Fried%20Chiles%20Stuffed%20with%20Potato%20(Mirchi%20Bada)&oldid=4506783","sourceSha256":"50e322f87c49b4f0fe27073e909d70fd3138af379fb22cc721e4f010b2bb2344","parserVersion":"wikibooks-sections-v3","quantityParserVersion":"source-prefix-v2","license":{"id":"wikibooks-cookbook-cc-by-sa-4.0","name":"Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0); Wikibooks text is generally dual-licensed with GFDL unless otherwise noted","evidenceUrl":"https://en.wikibooks.org/wiki/Wikibooks:Copyrights","policyStatus":"verified-license","pageExceptionStatus":"not-reviewed-per-page","attribution":"Attribute Wikibooks contributors by linking each version-specific source page. Indicate that structured fields are extracted and any translated or edited text is modified. Include CC BY-SA 4.0 notice/link and share adaptations under CC BY-SA 4.0 or later.","changeNoticeRequired":true,"shareAlikeRequired":true},"reviewStatus":"source-extracted-unreviewed","changeNotice":"Source-language section extraction; markup removed. Not culinarily reviewed, translated or runtime-approved.","recipe":{"name":"Deep Fried Chiles Stuffed with Potato (Mirchi Bada)","nameAr":null,"servings":null,"se