up|cup]] [[cookbook:Paprika|paprika]]\n* ¼ cup [[Cookbook:Brown Sugar|light brown sugar]]\n* 3 [[Cookbook:Tablespoon|tbsp]] [[cookbook:Salt|salt]]\n* 1 [[Cookbook:Teaspoon|tsp]] [[Cookbook:Mustard|dry mustard]]\n* 1 tsp ground [[Cookbook:Pepper|black pepper]]\n* ½ tsp [[cookbook:Cayenne Pepper|cayenne pepper]]\n* ½ tsp ground [[cookbook:cumin|cumin]]\n\n== Procedure ==\n\n# Combine ingredients in a Zip-Lock bag, shaking thoroughly.\n# Store in airtight container.\n\n[[Category:Recipes for spice mixes]]\n[[Category:Texas recipes]]\n[[Category:Recipes using light brown sugar]]\n[[Category:Recipes using cayenne]]\n[[Category:Recipes using ground cumin]]\n[[Category:Recipes using salt]]\n[[Category:Recipes using pepper]]\n[[Category:Recipes using mustard powder]]","isRecipe":true,"recipe":{"name":"Dry Rub","nameAr":null,"servings":null,"servingsSourceText":null,"ingredients":[{"id":"source-line-1","name":"¼ cup paprika","sourceText":"¼ cup paprika","amountText":"¼ cup paprika","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-2","name":"¼ cup light brown sugar","sourceText":"¼ cup light brown sugar","amountText":"¼ cup light brown sugar","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-3","name":"3 tbsp salt","sourceText":"3 tbsp salt","amountText":"3 tbsp salt","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-4","name":"1 tsp dry mustard","sourceText":"1 tsp dry mustard","amountText":"1 tsp dry mustard","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-5","name":"1 tsp ground black pepper","sourceText":"1 tsp ground black pepper","amountText":"1 tsp ground black pepper","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-6","name":"½ tsp cayenne pepper","sourceText":"½ tsp cayenne pepper","amountText":"½ tsp cayenne pepper","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-7","name":"½ tsp ground cumin","sourceText":"½ tsp ground cumin","amountText":"½ tsp ground cumin","amount":n