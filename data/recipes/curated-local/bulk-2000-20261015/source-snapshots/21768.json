"unresolved","amount":null,"unit":null,"quantityText":null,"unitText":null,"remainingText":null,"reason":"no-unambiguous-leading-quantity","reviewStatus":"unreviewed-source-transcription"},"sourceStructure":{"parserVersion":"source-structure-v1","reviewStatus":"source-cues-unreviewed","sourceGroupPath":[{"level":3,"title":"Meat (optional)","sourceHeading":"===Meat (optional)==="}],"optionalityCue":null,"alternativeCue":null,"quantityQualifier":null,"alternatives":null,"selectedAlternative":null,"optional":null}}],"steps":[{"n":1,"text":"If using tofu, cook it.","durationMinutes":null},{"n":2,"text":"If using onions, dice them into whatever size you prefer.","durationMinutes":null},{"n":3,"text":"If using bok choy, separate the stalk part from the leaf part. Slice the leaf part crosswise into ¾-inch-thick strips, then tear the strips into 2-inch pieces. These pieces will be treated much like the bean sprouts, though perhaps with slightly more cooking. The stalk part will be treated as celery.","durationMinutes":null},{"n":4,"text":"If using bean sprouts, wash them and discard any that are not white and crunchy.","durationMinutes":null},{"n":5,"text":"If using meat, slice into desired sized pieces and cook.","durationMinutes":null},{"n":6,"text":"Add a generous amount of oil to a large frying pan (more than you think you'd need) to avoid sticking. If using a type of sausage or other excessively fatty meat, not as much oil may be needed because of the amount of fat.","durationMinutes":null},{"n":7,"text":"Add the rice. Cook over the stove on medium-high heat.","durationMinutes":null},{"n":8,"text":"Add the soy sauce, meat(s), eggs, and all vegetables except the onions and bean sprouts.","durationMinutes":null},{"n":9,"text":"Add pepper, a pinch or two of sugar, and optionally some added salt.","durationMinutes":null},{"n":10,"text":"Add the tofu, bean sprouts, and onion when the rice is almost done (depending on how fried you want them), being careful not to overcook them.","durationMinutes":null}],"nutrition":null}},"authoritativeEvidence":{"sourceFileSha256":"93e85705e9141453d5708622c321c17fc793b4fbacfb0663d079fd365e1385d0","parsedRecipesSha256":"b03a74dbe473f11d42d9a7456834d930384c3188d2cf6cae512dfe3cbb50dad5","categoryObservationsSha256":"44b3f050f8fb7ed4bed800554d280e8f9251ea58830e90257f18049ecd70f350"}}
