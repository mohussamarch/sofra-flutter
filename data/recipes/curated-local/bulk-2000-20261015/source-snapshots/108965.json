 [[Cookbook:Salt|Salt]]\n* [[Cookbook:Pepper|Pepper]]\n* 1 [[Cookbook:Pinch|pinch]] [[Cookbook:Nutmeg|nutmeg]]\n* [[Cookbook:Stock|Stock]]\n\n== Procedure ==\n\n# Pound the poultry breast. Mix in ground rice, egg yolk, salt, pepper, and nutmeg.\n# Pass the mixture through a [[Cookbook:Sieve|sieve]].\n# Form the mixture into [[Cookbook:Quenelle|quenelles]].\n# [[Cookbook:Simmering|Simmer]] the quenelles in the stock to make a soup.\n\n[[Category:Recipes for soup]]\n[[Category:Recipes using egg yolk]]\n[[Category:Recipes using salt]]\n[[Category:Recipes using pepper]]\n[[Category:Recipes using nutmeg]]\n[[Category:Recipes using broth and stock]]","isRecipe":true,"recipe":{"name":"Italian Soup with Poultry Quenelles","nameAr":null,"servings":null,"servingsSourceText":null,"ingredients":[{"id":"source-line-1","name":"Poultry breast","sourceText":"Poultry breast","amountText":"Poultry breast","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-2","name":"1 tsp ground rice","sourceText":"1 tsp ground rice","amountText":"1 tsp ground rice","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-3","name":"1 egg yolk","sourceText":"1 egg yolk","amountText":"1 egg yolk","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-4","name":"Salt","sourceText":"Salt","amountText":"Salt","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-5","name":"Pepper","sourceText":"Pepper","amountText":"Pepper","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-6","name":"1 pinch nutmeg","sourceText":"1 pinch nutmeg","amountText":"1 pinch nutmeg","amount":null,"unit":null,"foodBinding":null},{"id":"source-line-7","name":"Stock","sourceText":"Stock","amountText":"Stock","amount":null,"unit":null,"foodBinding":null}],"steps":[{"n":1,"text":"Pound the poultry breast. Mix in ground rice, egg yolk, salt, pepper, and nutmeg.","sourceText":"Pound the poultry breast. Mix in ground rice, egg yolk, salt, pepper, and nutmeg.","durationMinutes":nu