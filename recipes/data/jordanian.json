      ],
      "steps": [
        {
          "n": 1,
          "text": "ضع كل مكونات المرق في قدر عميق كبير واتركها حتى تغلي غلياناً كاملاً، وأزل الرغوة التي تتكون على السطح.",
          "duration": null
        },
        {
          "n": 2,
          "text": "اترك اللحم يغلي حتى ينضج بالكاد.",
          "duration": 30,
          "passive": true
        },
        {
          "n": 3,
          "text": "ارفع اللحم جانباً، ثم صفِّ المرق وتخلّص من البقايا الصلبة.",
          "duration": null
        },
        {
          "n": 4,
          "text": "أعد المرق إلى قدر نظيف مع الجميد السائل والزبادي المخفوق والفلفل الأسود، وقلّب باستمرار على نار هادئة إلى متوسطة حتى لا يتقطع، وأضف الملح إذا احتاج.",
          "duration": null
        },
        {
          "n": 5,
          "text": "أعد اللحم إلى الصلصة واتركه على نار هادئة حتى تثقل الصلصة وتغلّف اللحم ويصبح طرياً ينفصل عن العظم.",
          "duration": null,
          "passive": true
        },
        {
          "n": 6,
          "text": "للأرز: سخّن السمن في قدر سميك القاع، وأضف الهيل والأرز المصفّى والكركم وقلّب حتى تتغلف الحبات بالسمن.",
          "duration": null
        },
        {
          "n": 7,
          "text": "أضف الماء الساخن والملح واتركه يغلي، ثم خفّف النار حتى يتشرب الأرز معظم الماء.",
          "duration": null,
          "passive": true
        },
        {
          "n": 8,
          "text": "قلّب الأرز مرة واحدة، وغطّه بورق قصدير أو فوطة ثم بغطاء ثقيل واتركه على النار، ثم ارفعه واتركه يرتاح مغطى 15 دقيقة.",
          "duration": 5,
          "passive": true
        },
        {
          "n": 9,
          "text": "غطِّ طبق تقديم كبير بخبز الشراك، ثم افرد الأرز فوقه ورتّب اللحم واسكب معظم صلصة الجميد على الطبق.",
          "duration": null
        },
        {
          "n": 10,
          "text": "رشّ اللوز المحمص، وقدّم باقي الصلصة في وعاء جانبي مع سلطة.",
          "duration": null
        }
      ],
