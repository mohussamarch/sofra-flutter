      "steps": [
        {
          "n": 1,
          "text": "اخلط القرفة مع جوزة الطيب والقرنفل والفلفل والملح، وافرك الدجاج بنصف الخليط واحتفظ بالباقي.",
          "duration": null
        },
        {
          "n": 2,
          "text": "سخّن الفرن على 60 درجة لتدفئة صينية وأطباق التقديم. اخلط البصل المقطع والثوم والزنجبيل مع الزيت في الخلاط حتى يصبح معجوناً ناعماً.",
          "duration": null
        },
        {
          "n": 3,
          "text": "اقلِ المعجون في قدر، ثم أضف باقي خليط البهارات والهيل وورق اللورا وقلّب قليلاً.",
          "duration": 5
        },
        {
          "n": 4,
          "text": "ارفع النار وأضف الدجاج وحمّره من كل جانب نحو 5 دقائق.",
          "duration": 10
        },
        {
          "n": 5,
          "text": "أضف المرق واتركه يغلي، ثم غطِّ القدر واتركه على نار هادئة. ارفع الدجاج إلى الفرن الدافئ واحتفظ بالسائل.",
          "duration": 15,
          "passive": true
        },
        {
          "n": 6,
          "text": "اغسل الأرز بماء بارد حتى يصفو الماء وصفّه. سخّن الزيت وقلّب فيه الأرز والعدس قليلاً، ثم أضف السائل المحفوظ واتركه يغلي.",
          "duration": null
        },
        {
          "n": 7,
          "text": "غطِّ القدر وارفعه عن النار واتركه دون فتح الغطاء حتى يتشرب الأرز السائل، ثم قلّب الزعفران في الأرز بالشوكة.",
          "duration": 15,
          "passive": true
        },
        {
          "n": 8,
          "text": "انقع الزبيب في ماء الورد.",
          "duration": 5,
          "passive": true
        },
        {
          "n": 9,
          "text": "حمّص الزبيب واللوز في مقلاة جافة مع التقليب من حين لآخر، ثم ارفعهما جانباً.",
          "duration": 5
        },
        {
          "n": 10,
          "text": "سخّن الزيت في المقلاة نفسها، وحمّر الدجاج على جهة الجلد حتى يقرمش، ثم اقلبه دقيقتين أخريين.",
          "duration": 7
        },
        {
          "n": 11,
          "text": "قدّم الدجاج مع الأرز ووزّع خليط اللوز والزبيب على الوجه.",
          "duration": null
        }
      ],
