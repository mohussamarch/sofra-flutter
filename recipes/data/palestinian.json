          "note": "خُمس كوب كما في المصدر"
        },
        {
          "id": "salt",
          "name": "ملح",
          "amount": null,
          "unit": null,
          "label": "حسب الرغبة",
          "scale": false
        },
        {
          "id": "black-pepper",
          "name": "فلفل أسود",
          "amount": null,
          "unit": null,
          "label": "حسب الرغبة",
          "scale": false
        },
        {
