          "name": "صنوبر محمص",
          "amount": 0.5,
          "unit": "كوب"
        }
      ],
      "steps": [
        {
          "n": 1,
          "text": "ضع الدجاج في الماء مع الملح والفلفل والبصلة الصغيرة واتركه حتى يغلي، وأزل الرغوة عن السطح.",
          "duration": null
        },
        {
          "n": 2,
          "text": "خفّف النار واترك الدجاج يطهى حتى ينضج تماماً.",
          "duration": 45,
          "passive": true
        },
        {
          "n": 3,
          "text": "اترك الدجاج يبرد، ثم انزع العظم وفتّت اللحم.",
          "duration": null
        },
        {
          "n": 4,
          "text": "اقلِ شرائح البصل في زيت الزيتون حتى تأخذ لوناً ذهبياً.",
          "duration": null
        },
        {
          "n": 5,
          "text": "أضف الملح والفلفل والصنوبر والسماق والدجاج المفتت، وقلّب الخليط على النار قليلاً.",
          "duration": 2
        },
        {
          "n": 6,
          "text": "ضع قليلاً من الحشوة في وسط كل قطعة خبز ولفّها، ثم ادهن وجهها بزيت الزيتون.",
          "duration": null
        },
        {
          "n": 7,
          "text": "اخبز اللفائف في فرن على حرارة 175 درجة حتى تصبح مقرمشة ومحمّرة.",
          "duration": 30,
          "passive": true
        },
        {
          "n": 8,
          "text": "قدّمها ساخنة.",
          "duration": null
        }
      ],
