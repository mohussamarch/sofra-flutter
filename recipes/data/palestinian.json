      "steps": [
        {
          "n": 1,
          "text": "سخّن الزيت والسمن في قدر وشوّح البصل والثوم حتى تفوح رائحتهما.",
          "duration": null
        },
        {
          "n": 2,
          "text": "أضف قطع اللحم وحمّرها حتى يختفي اللون الوردي ويصبح لونها بنياً فاتحاً، ثم أضف البهارات الكاملة والمطحونة.",
          "duration": null
        },
        {
          "n": 3,
          "text": "اغمر اللحم بالماء واتركه يغلي بقوة، وأزل الرغوة، ثم غطِّ القدر وخفّف النار إلى متوسطة منخفضة.",
          "duration": 5
        },
        {
          "n": 4,
          "text": "اترك اللحم يطهى من ساعة إلى ساعتين حتى يطرى (الكتف يحتاج نحو ساعة ونصف).",
          "duration": 60,
          "passive": true
        },
        {
          "n": 5,
          "text": "ارفع اللحم، ثم صفِّ المرق واحفظه.",
          "duration": null
        },
        {
          "n": 6,
          "text": "للأرز: سخّن السمن في قدر على نار متوسطة إلى عالية، وشوّح البصل المفروم وفصوص الثوم حتى يتحمر البصل ويأخذ الثوم لوناً خفيفاً.",
          "duration": null
        },
        {
          "n": 7,
          "text": "أضف الحمص المصفى وقلّبه حتى يسخن.",
          "duration": 2
        },
        {
          "n": 8,
          "text": "أضف الأرز والبهارات المطحونة والكاملة ومرق اللحم البودرة وقلّب جيداً، ثم رتّب اللحم المطهو فوقه.",
          "duration": null
        },
        {
          "n": 9,
          "text": "اسكب المرق الساخن واتركه يغلي بقوة حتى يصل السائل إلى سطح الأرز.",
          "duration": 5
        },
        {
          "n": 10,
          "text": "غطِّ القدر وخفّف النار إلى هادئة حتى يتشرب الأرز المرق وينفش.",
          "duration": 15,
          "passive": true
        },
        {
          "n": 11,
          "text": "قدّم القدرة ساخنة، ويمكن تزيينها حسب الرغبة.",
          "duration": null
        }
