      "steps": [
        {
          "n": 1,
          "text": "في قدر كبير سخّن زيت الزيتون وأضف الثوم والبصل واطههما حتى يذهبا إلى اللون الذهبي.",
          "duration": null
        },
        {
          "n": 2,
          "text": "اسكب البيرة واتركها تغلي بهدوء نحو 5 دقائق حتى يتبخر الكحول.",
          "duration": null
        },
        {
          "n": 3,
          "text": "أضف مرق اللحم وصلصة الطماطم المقلية ونبيذ البورت والبيريبيري والزبدة لإعطاء الصلصة لمعاناً. أضف نشا الذرة ببطء لتجنب التكتل واتركها تغلي دقائق حتى تثخن.",
          "duration": null
        },
        {
          "n": 4,
          "text": "سخّن الفرن إلى 180°C/350°F.",
          "duration": null
        },
        {
          "n": 5,
          "text": "اطه لحم البقر المقطع شرائط صغيرة وتبّله بالملح والفلفل الأسود.",
          "duration": null
        },
        {
          "n": 6,
          "text": "اطه نقانق اللينغويشا بعد شقها طولياً إلى نصفين.",
          "duration": null
        },
        {
          "n": 7,
          "text": "لكل شطيرة خذ أربع شرائح خبز. اقطع وسط شريحتين لتوفير مكان للحشو، واجعل الشريحتين الأخريين القاعدة والغطاء.",
          "duration": null
        },
        {
          "n": 8,
          "text": "احش الخبز بالنقانق ولحم البقر والهام المفروم خشناً. غط الشطائر بالجبن وأذب الجبن في الفرن 5 دقائق.",
          "duration": null
        },
        {
          "n": 9,
          "text": "غطّها بالصلصة وقدّمها مع البطاطا المقلية.",
          "duration": null
        }
