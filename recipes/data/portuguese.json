        {
          "id": "bc650-portuguese-creamy-cod-ing-7",
          "name": "جبن مبشور مثل موزاريلا",
          "amount": null,
          "unit": null,
          "scale": false,
          "display": "grated cheese (mozzarella works fine)"
        },
        {
          "id": "bc650-portuguese-creamy-cod-ing-8",
          "name": "جوزة الطيب مطحونة",
          "amount": null,
          "unit": null,
          "scale": false,
          "display": "ground nutmeg"
        }
      ],
      "steps": [
        {
          "n": 1,
          "text": "صبي الحليب في قدر واتركيه يغلي، ثم ضعي الفيليه فيه واغليه 10–15 دقيقة.",
          "duration": null
        },
        {
          "n": 2,
          "text": "قطعي البصل واقليه بزيت الزيتون حتى يكتسب لونًا ذهبيًا. صفي السمك واحتفظي بالحليب، ثم فتتي السمك واخلطيه بالبصل واقليه بضع دقائق. أضيفي الحليب المستخدم والدقيق للتكثيف، واتركيه على نار منخفضة 5–10 دقائق حتى يصل للقوام المرغوب.",
          "duration": null
        },
        {
          "n": 3,
          "text": "قطعي البطاطس مكعبات بحجم النرد واقليها قليلًا في زيت أو زيت زيتون على نار منخفضة 5–10 دقائق، دون قلي عميق.",
          "duration": null
        },
        {
          "n": 4,
          "text": "ادهني صينية فرن بزيت الزيتون وضعي فيها السمك والبطاطس واخلطيهما. أضيفي جوزة الطيب والملح والفلفل.",
          "duration": null
        },
        {
          "n": 5,
          "text": "اسكبي الكريمة ورشي الجبن. اخبزي نحو 20 دقيقة حتى يصبح الوجه ذهبيًا ومقرمشًا.",
          "duration": null
        }
      ],
