      "steps": [
        {
          "n": 1,
          "text": "ضع الدجاج في قدر واغمره بالماء واتركه حتى يغلي، مع إزالة الدهون والرغوة عن السطح.",
          "duration": null
        },
        {
          "n": 2,
          "text": "أضف البهارات والبصل والثوم واتركه على نار هادئة حتى يطرى الدجاج، وأضف الملح والفلفل قبل إطفاء النار بدقائق.",
          "duration": 45,
          "passive": true
        },
        {
          "n": 3,
          "text": "ارفع الدجاج، ثم صفِّ المرق وتخلّص من البصل والثوم وباقي البهارات الصلبة.",
          "duration": null
        },
        {
          "n": 4,
          "text": "انقع الأرز في ماء دافئ مسبقاً ثم صفّه.",
          "duration": 30,
          "passive": true
        },
        {
          "n": 5,
          "text": "أضف الأرز إلى المرق، وزد الماء إن لم يكفِ، واتركه حتى ينضج.",
          "duration": null,
          "passive": true
        },
        {
          "n": 6,
          "text": "أثناء طهي الأرز اقلِ قطع الدجاج في مقلاة منفصلة حتى يتحمر سطحها ويصبح مقرمشاً.",
          "duration": null
        },
        {
          "n": 7,
          "text": "عندما يقترب الأرز من النضج ضع الدجاج المقلي فوقه، ثم قدّمه كما هو أو بعد تقليبه.",
          "duration": null
        }
      ],
