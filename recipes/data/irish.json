  "recipes": [
    {
      "id": "bc650-irish-beef-stew",
      "name": "يخنة لحم على الطريقة الأيرلندية",
      "nameEn": "Traditional beef or lamb stew",
      "cuisine": "أيرلندي",
      "category": "طبق رئيسي",
      "description": "يذكر المصدر أن اليخنة الأيرلندية تُحضّر تقليديًا بلحم الضأن، ويقترح لحم البقر بديلًا.",
      "servings": null,
      "prepTime": null,
      "cookTime": null,
      "totalTime": null,
      "difficulty": "غير محدد بالمصدر",
      "metadataPolicy": "source-unknowns-v1",
      "ingredients": [
        {
          "id": "bc650-irish-beef-stew-ing-1",
          "name": "كتف ضأن أو لحم بقري تشاك",
          "amount": null,
          "unit": null,
          "scale": false,
          "display": "Lamb shoulder or beef chuck"
        },
        {
          "id": "bc650-irish-beef-stew-ing-2",
          "name": "بصل وكرفس وجزر وثوم",
          "amount": null,
          "unit": null,
          "scale": false,
          "display": "Onion, celery, carrot and garlic"
        },
        {
          "id": "bc650-irish-beef-stew-ing-3",
          "name": "زعتر وإكليل الجبل وورق غار",
          "amount": null,
          "unit": null,
          "scale": false,
          "display": "Thyme, rosemary and some bay leaves."
        },
        {
          "id": "bc650-irish-beef-stew-ing-4",
          "name": "مرق لحم بقري أو دجاج",
          "amount": null,
          "unit": null,
          "scale": false,
          "display": "Beef or chicken stock"
        },
        {
          "id": "bc650-irish-beef-stew-ing-5",
          "name": "زجاجة ستاوت أو بورتر (اختياري)",
          "amount": null,
          "unit": null,
          "scale": false,
          "optional": true,
          "display": "a bottle of stout or porter"
        },
        {
          "id": "bc650-irish-beef-stew-ing-6",
          "name": "بطاطس للتكثيف (اختياري حسب الطريقة)",
          "amount": null,
          "unit": null,
          "scale": false,
          "display": "cut up potatoes; source method only"
        },
        {
          "id": "bc650-irish-beef-stew-ing-7",
          "name": "دقيق وماء للتكثيف (بديل اختياري)",
          "amount": null,
          "unit": null,
          "scale": false,
          "optional": true,
          "display": "a teaspoon of flour with water; source method alternative"
        }
      ],
      "steps": [
        {
          "n": 1,
          "text": "قطعي البصل والجزر والكرفس إلى قطع بحجم لقمة تقريبًا، قريبة من حجم اللحم. يمكن إبقاء الثوم كاملًا.",
          "duration": null
        },
        {
          "n": 2,
          "text": "حمري اللحم من جميع الجهات في قدر كبير مع قليل من الزيت وعلى دفعات كي لا تزدحم القدر.",
          "duration": null
        },
        {
          "n": 3,
          "text": "أخرجي اللحم وأضيفي الخضروات. يقول المصدر إن إضافة الملح تساعد على إخراج رطوبة الخضروات وفك القطع المتكرملة من قاع القدر.",
          "duration": null
        },
        {
          "n": 4,
          "text": "اختياري: أعيدي اللحم وأضيفي نحو ثلث علبة من ستاوت أو بيرة داكنة لفك قاع القدر. انتظري حتى يتبخر الكحول تمامًا قبل التقليب أو المتابعة.",
          "duration": null
        },
        {
          "n": 5,
          "text": "أعيدي اللحم إلى القدر وأضيفي المرق والأعشاب. خففي الحرارة واتركيها على نار هادئة نحو ساعتين إلى ساعتين ونصف.",
          "duration": null
        },
        {
          "n": 6,
          "text": "بعد ساعتين قد تبقى اليخنة مائية؛ يمكن إضافة بطاطس مقطعة لآخر نصف ساعة لتكثيفها، أو خلط ملعقة صغيرة دقيق بماء وإضافته تدريجيًا مع الخفق.",
          "duration": null
        },
        {
          "n": 7,
          "text": "يُقترح تقديمها مع بطاطس مهروسة.",
          "duration": null
        }
      ],
      "tags": [
        "طبق رئيسي"
      ],
      "notes": "المقادير والحصص وأزمنة التحضير والطهي غير محددة في رأس المصدر. مدد المراحل تبقى داخل النص كما وردت. بلد الوصفة مدعوم بوصف المصدر بأنه يخنة أيرلندية تقليدية. | مصدر: https://github.com/LukeSmithxyz/based.cooking/blob/9d4a31a040eedd61e4fb608cb0c114ff9a7c4dd2/content/beef-stew.md ؛ revision=9d4a31a040eedd61e4fb608cb0c114ff9a7c4dd2 ؛ snapshotSHA256=1f4f07304be38405990d7a435d001d5db003d477105ea71bfb993eade0aeecd8"
    },
