          "amount": 1,
          "unit": "ملعقة صغيرة"
        },
        {
          "id": "tomato-paste",
          "name": "صلصة طماطم (معجون)",
          "amount": 1,
          "unit": "ملعقة كبيرة",
          "note": "ملعقة كبيرة ممتلئة"
        },
        {
          "id": "olive-oil",
          "name": "زيت زيتون",
          "amount": 4,
          "unit": "ملعقة كبيرة"
        },
        {
          "id": "bay-leaf",
          "name": "ورق لورا",
          "amount": 1,
          "unit": "ورقة"
        },
        {
          "id": "water",
          "name": "ماء مغلي",
          "amount": null,
          "unit": null,
          "label": "حسب الرغبة",
          "scale": false
        }
      ],
      "steps": [
        {
          "n": 1,
          "text": "انقع الفاصوليا المجففة عدة ساعات، أو اغسل المعلبة وصفّها.",
          "duration": null,
          "passive": true
        },
        {
          "n": 2,
          "text": "اطبخ الفاصوليا المنقوعة في قدر الضغط حتى تطرى.",
          "duration": 30,
          "passive": true
        },
        {
          "n": 3,
          "text": "اهرس الثوم مع الكمون والملح حتى يصبح معجونًا ناعمًا (الدرسة)، وخففه بقليل من الماء.",
          "duration": null
        },
        {
          "n": 4,
          "text": "سخّن زيت الزيتون مع ورقة اللورا، ثم أضف معجون الطماطم والدرسة وقلّب حتى ينفصل الزيت.",
          "duration": null
        },
        {
          "n": 5,
          "text": "صب الماء المغلي ثم أضف الفاصوليا، واتركها تغلي بهدوء حتى تتكثف الصلصة وتطرى الحبوب.",
          "duration": null,
          "passive": true
        },
        {
          "n": 6,
          "text": "تذوّق واضبط الملح أو الكمون أو معجون الطماطم حسب الحاجة، وقدّمها ساخنة.",
          "duration": null
        }
      ],
      "tags": [],
      "notes": "المصدر: https://www.amourdecuisine.fr/en/article-algerian-butter-bean-stew-loubia-bel-kamoun.html | الموقع: Amour de cuisine | المقادير والأوقات من المصدر؛ الخطوات مكتوبة بصياغتنا، ولم يُستنتج مقدار أو زمن غير مذكور.",
