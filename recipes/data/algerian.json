          "note": "يُضبط لاحقًا حسب الرغبة"
        },
        {
          "id": "black-pepper",
          "name": "فلفل أسود",
          "amount": 0.5,
          "unit": "ملعقة صغيرة",
          "note": "يُضبط لاحقًا حسب الرغبة"
        },
        {
          "id": "tomato-paste",
          "name": "صلصة طماطم (معجون)",
          "amount": 1,
          "unit": "ملعقة صغيرة"
        },
        {
          "id": "water",
          "name": "ماء",
          "amount": 4,
          "unit": "كوب"
        },
        {
          "id": "chickpeas",
          "name": "حمص (معلب أو مجفف منقوع)",
          "amount": 0.5,
          "unit": "كوب"
        }
      ],
      "steps": [
        {
          "n": 1,
          "text": "اغسل الفريك بماء بارد وانزع أي حبيبات داكنة غريبة، ثم صفِّه واتركه جانبًا.",
          "duration": null
        },
        {
          "n": 2,
          "text": "افرم البصل ناعمًا وقطّع اللحم مكعبات صغيرة، وابشر الطماطم بعد قسمها نصفين لتأخذ لبها وتتخلص من القشر، وافرم الكزبرة.",
          "duration": null
        },
        {
          "n": 3,
          "text": "سخّن الزيت في قدر متوسط على نار متوسطة وقلّب البصل بضع دقائق حتى يطرى، ثم أضف اللحم وحمّره بهدوء من كل الجهات.",
          "duration": null
        },
        {
          "n": 4,
          "text": "أضف البهارات الجافة والنعناع والملح والفلفل وقلّب دقيقة.",
          "duration": 1
        },
        {
          "n": 5,
          "text": "أضف الكزبرة ومعجون الطماطم والطماطم المبشورة ثم الماء، وأضف الحمص الآن إن كان مجففًا ومنقوعًا.",
          "duration": null
        },
        {
          "n": 6,
          "text": "غطِّ القدر واتركه حتى يبدأ في الغليان، ثم اخفض النار واتركه يغلي بهدوء حتى يطرى اللحم (45 دقيقة إلى ساعة).",
          "duration": 45,
          "passive": true
        },
        {
          "n": 7,
          "text": "أضف الفريك والحمص المعلب إن استخدمته، وغطِّ القدر حتى ينضج الفريك.",
          "duration": 15,
          "passive": true
        },
        {
          "n": 8,
          "text": "قدّمها ساخنة مع قليل من الكزبرة المفرومة على الوجه.",
          "duration": null
        }
      ],
