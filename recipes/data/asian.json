      "steps": [
        {
          "n": 1,
          "text": "اخلط مكونات الصلصة في وعاء.",
          "duration": null
        },
        {
          "n": 2,
          "text": "قطّع الدجاج إلى قطع بحجم لقمة.",
          "duration": null
        },
        {
          "n": 3,
          "text": "ضع الدقيق في طبق ضحل واخلط معه مسحوق الثوم والملح والفلفل، نصف ملعقة صغيرة من كل منها.",
          "duration": null
        },
        {
          "n": 4,
          "text": "ضع البيضة المخفوقة قليلاً في طبق ضحل آخر.",
          "duration": null
        },
        {
          "n": 5,
          "text": "غطّ الدجاج بنشا الذرة، ثم اغمسْه في البيض، ثم غطّه بالدقيق المتبل.",
          "duration": null
        },
        {
          "n": 6,
          "text": "سخّن كمية جيدة من الزيت في مقلاة للقلي؛ ينبغي أن يكون ساخناً بما يكفي ليصدر الدجاج صوت أزيز عند وضعه. اقله على دفعات إذا لزم.",
          "duration": null
        },
        {
          "n": 7,
          "text": "اقْلِ حتى ينضج الدجاج ويكتسب غلافاً ذهبياً بنياً.",
          "duration": null
        },
        {
          "n": 8,
          "text": "اسكب الزيت الزائد، وأضف الصلصة وقلّب لتغطي الدجاج. ويمكن رفع الدجاج على مناديل المطبخ وقلي دفعة أخرى.",
          "duration": null
        },
        {
          "n": 9,
          "text": "اترك الصلصة تغلي فقاعات دقيقة أو دقيقتين.",
          "duration": null
        },
        {
          "n": 10,
          "text": "قدّم مع أرز مسلوق.",
          "duration": null
        }
      ],
