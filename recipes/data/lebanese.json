      ],
      "steps": [
        {
          "n": 1,
          "text": "ضع العدس والماء في قدر كبير على حرارة متوسطة واتركه يغلي.",
          "duration": null
        },
        {
          "n": 2,
          "text": "في مقلاة شوّح البصل حتى يلين ويصبح وردياً، نحو 5 دقائق. أضف السلق المفروم وشوّحهما معاً 2–3 دقائق حتى يذبل السلق.",
          "duration": null
        },
        {
          "n": 3,
          "text": "بعد طهي العدس نحو 8 دقائق أضف خليط البصل والسلق والبطاطا والكوسة إلى الماء المغلي.",
          "duration": null
        },
        {
          "n": 4,
          "text": "أضف الملح والفلفل حسب الذوق.",
          "duration": null
        },
        {
          "n": 5,
          "text": "خفّض الحرارة إلى متوسطة منخفضة وغط القدر واطه حتى ينضج العدس والبطاطا تماماً، نحو 12 دقيقة.",
          "duration": null
        },
        {
          "n": 6,
          "text": "أضف الكزبرة المفرومة وحرّك واطه نحو 5 دقائق.",
          "duration": null
        },
        {
          "n": 7,
          "text": "أضف عصير الليمون والكمون قبل التقديم.",
          "duration": null
        }
