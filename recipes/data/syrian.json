      ],
      "steps": [
        {
          "n": 1,
          "text": "قشّر الباذنجان خطوطًا واترك العنق، ثم اشقّ جانبًا واحدًا شقًا عميقًا دون أن يصل إلى الطرفين لتكوين جيب.",
          "duration": null
        },
        {
          "n": 2,
          "text": "رشّ الملح داخل الجيوب وضع الباذنجان مقلوبًا ليصفو ماؤه المر.",
          "duration": 20,
          "passive": true
        },
        {
          "n": 3,
          "text": "جفّفه وادهنه بالزيت واشوِه على 200 درجة مع تقليبه مرة حتى يلين تمامًا.",
          "duration": 20
        },
        {
          "n": 4,
          "text": "حمّص الصنوبر في مقلاة جافة ثم أخرجه فورًا، وحمّر البصل في المقلاة نفسها حتى يشف.",
          "duration": null
        },
        {
          "n": 5,
          "text": "أضف اللحم إلى البصل وافركه بملعقة حتى يختفي اللون الوردي، ثم نكّه ببهار السبع والملح وأضف معظم الصنوبر.",
          "duration": null
        },
        {
          "n": 6,
          "text": "افتح جيوب الباذنجان واحشها بسخاء حتى تبدو ممتلئة قليلًا، ورتّبها في صينية متقاربة.",
          "duration": null
        },
        {
          "n": 7,
          "text": "اخفق اللبن مع بياض البيض والنشاء وملعقة ملح في قدر بارد، ثم سخّنه على نار متوسطة مع التحريك المستمر باتجاه واحد حتى يثخن ويغطي الملعقة.",
          "duration": null
        },
        {
          "n": 8,
          "text": "اسكب اللبن الساخن على الباذنجان حتى يغطي ثلثيه ثم اخبزه على 180 درجة حتى تظهر نقط ذهبية على السطح.",
          "duration": 20,
          "passive": true
        },
        {
          "n": 9,
          "text": "حمّر الثوم والنعناع المجفف في ملعقة زبدة نصف دقيقة واسكبهما فوق الطبق مع بقية الصنوبر، وقدّمه مع أرز أبيض.",
          "duration": null
        }
