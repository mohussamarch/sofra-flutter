        }
      ],
      "steps": [
        {
          "n": 1,
          "text": "سخّن الزيت في قدر كبير وحمّر السيقان من كل الجهات حتى يذهب لونها.",
          "duration": null
        },
        {
          "n": 2,
          "text": "أعد السيقان إلى القدر وأضف البصل المقطّع والماء واتركه يغلي.",
          "duration": null
        },
        {
          "n": 3,
          "text": "أزل الرغوة المتكونة على السطح، ثم أضف ورق الغار والحبهان وعيدان القرفة والبهار الحلو والقرنفل والفلفل الأسود والملح.",
          "duration": null
        },
        {
          "n": 4,
          "text": "اطبخ القدر تحت الضغط حتى يلين اللحم، أو اتركه على النار ساعة إلى ساعة ونصف على حسب نوع اللحم.",
          "duration": 45,
          "passive": true
        },
        {
          "n": 5,
          "text": "أخرج السيقان من المرق وصفِّ المرق من البصل والبهارات الصحيحة.",
          "duration": null
        },
        {
          "n": 6,
          "text": "في قدر آخر اخلط اللبن والنشاء والبيضة والملح واخفق جيدًا قبل رفع النار.",
          "duration": null
        },
        {
          "n": 7,
          "text": "سخّن خليط اللبن على نار متوسطة مع التحريك المستمر حتى يبدأ بغليان خفيف.",
          "duration": 10
        },
        {
          "n": 8,
          "text": "أضف كوبين من مرق اللحم إلى اللبن مع التحريك وتحقّق من قوام الصلصة.",
          "duration": null
        },
        {
          "n": 9,
          "text": "ضع السيقان في صلصة اللبن واتركها تنضج على نار هادئة.",
          "duration": 10
        },
        {
          "n": 10,
          "text": "حمّر الثوم المهروس في زيت الزيتون حتى يذهب لونه واسكبه فوق الطبق مع النعناع المجفف والصنوبر، وقدّمه مع أرز بالشعرية.",
          "duration": null
        }
      ],
