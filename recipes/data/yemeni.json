    {
      "description": "وصفة موثقة من مصدرها الأولي.",
      "prepTime": null,
      "difficulty": "غير محدد",
      "cuisine": "يمني",
      "totalTime": null,
      "notes": "المصدر: https://www.sifrafoods.com/post/oxtail-yemeni-marag | بصمة الاستخراج: 6693425b7d6ef67e559db3144191f736277fbfc8b99ba96ba3f5b46ea3332c37 | المطبخ مذكور صراحة بالمصدر (Yemeni). المقادير محفوظة بنصها، والطريقة ملخصة وفق تسلسل المصدر؛ الأزمنة والحصص غير المنشورة مجهولة.",
      "steps": [
        {
          "tip": null,
          "text": "جففي قطع الذيل البقري وتبّلي جميع جوانبها بالملح والفلفل.",
          "passive": false,
          "duration": null,
          "n": 1
        },
        {
          "tip": null,
          "text": "حمّري اللحم على دفعات في الزيت من جميع الجوانب، ثم ارفعيه جانبًا.",
          "passive": false,
          "duration": null,
          "n": 2
        },
        {
          "tip": null,
          "text": "في القدر نفسه ليّني البصل والفلفل والبصل الأخضر وورق الغار بزيت الزيتون.",
          "passive": false,
          "duration": null,
          "n": 3
        },
        {
          "tip": null,
          "text": "أضيفي الثوم والهالابينو واطهيهما حتى تفوح رائحتهما وتبدأ أطراف البصل بالتحمير.",
          "passive": false,
          "duration": null,
          "n": 4
        },
        {
          "tip": null,
          "text": "أضيفي معجون الطماطم والحوائج والبابريكا والسازون الاختياري، واطهي الخليط 2–3 دقائق.",
          "passive": false,
          "duration": null,
          "n": 5
        },
        {
          "tip": null,
          "text": "أعيدي اللحم وما تساقط من عصائره إلى القدر.",
          "passive": false,
          "duration": null,
          "n": 6
        },
        {
          "tip": null,
          "text": "أضيفي مرق الدجاج والبطاطس والجزر والليمون المجفف، وضعي الخضار فوق اللحم.",
          "passive": false,
          "duration": null,
          "n": 7
        },
        {
          "tip": null,
          "text": "أضيفي الماء حتى يغطي الخضار.",
          "passive": false,
          "duration": null,
          "n": 8
        },
        {
          "tip": null,
          "text": "اطهي بقدر الضغط 35–45 دقيقة، أو بقدر هولندي مغطى 45–55 دقيقة حتى تلين البطاطس.",
          "passive": false,
          "duration": null,
          "n": 9
        },
        {
          "tip": null,
          "text": "ارفعي البطاطس والجزر الناضجين إلى وعاء وغطّيهما.",
          "passive": false,
          "duration": null,
          "n": 10
        },
        {
          "tip": null,
          "text": "واصلي طهي اللحم 30–50 دقيقة حتى يطرى بالشوكة، ثم اضبطي الملح وأعيدي الخضار.",
          "passive": false,
          "duration": null,
          "n": 11
        },
        {
          "tip": null,
          "text": "إذا جف السائل أضيفي الماء تدريجيًا بكوب في كل مرة حتى يصير القوام كما تفضلين.",
          "passive": false,
          "duration": null,
          "n": 12
        }
      ],
