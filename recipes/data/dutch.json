        }
      ],
      "steps": [
        {
          "n": 1,
          "text": "في قدر حساء كبير اغلِ الماء والبازلاء المجروشة وبطن الخنزير أو اللحم المقدد وقطعة لحم الخنزير ومكعب المرق.",
          "duration": null
        },
        {
          "n": 2,
          "text": "خفّض الحرارة حتى يغلي بهدوء، وغط القدر واطه 45 دقيقة مع التحريك من حين لآخر وإزالة أي رغوة تتكون على السطح.",
          "duration": null
        },
        {
          "n": 3,
          "text": "أخرج قطعة لحم الخنزير وانزع العظم وقطّع اللحم شرائح رفيعة، واتركه جانباً.",
          "duration": null
        },
        {
          "n": 4,
          "text": "أضف الكرفس والجزر والبطاطا والبصل والكراث والكرفس الجذري.",
          "duration": null
        },
        {
          "n": 5,
          "text": "أعد الحساء إلى الغليان ثم خفّضه واطه من دون غطاء 30 دقيقة أخرى.",
          "duration": null
        },
        {
          "n": 6,
          "text": "أضف النقانق المدخنة في آخر 15 دقيقة من الطهي.",
          "duration": null
        },
        {
          "n": 7,
          "text": "عندما تلين الخضار أخرج اللحم المقدد والنقانق وقطعهما شرائح رفيعة واتركهما جانباً.",
          "duration": null
        },
        {
          "n": 8,
          "text": "إذا فضلت قواماً ناعماً اهرس الحساء بخلاط يدوي.",
          "duration": null
        },
        {
          "n": 9,
          "text": "تبّل بالملح والفلفل حسب الذوق.",
          "duration": null
        },
        {
          "n": 10,
          "text": "أعد اللحم إلى الحساء واترك بعض شرائح النقانق جانباً.",
          "duration": null
        },
        {
          "n": 11,
          "text": "قدّم في أوعية مسخنة وزيّن بشرائح الرووكورست وأوراق كرفس مفرومة.",
          "duration": null
        }
      ],
