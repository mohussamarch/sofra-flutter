      "steps": [
        {
          "n": 1,
          "text": "سخّن زيت الزيتون في قدر واسع وضع مكعبات اللحم حتى تظهر عليها بقع محمرة.",
          "duration": null
        },
        {
          "n": 2,
          "text": "أضف شرائح البصل وقلّب حتى تصبح شفافة.",
          "duration": null
        },
        {
          "n": 3,
          "text": "أضف الثوم والفلفل الحار وقلّب دقيقة، ثم أضف الطماطم المهروسة.",
          "duration": 1
        },
        {
          "n": 4,
          "text": "اترك الطماطم تطهى قليلًا مع التقليب.",
          "duration": 2
        },
        {
          "n": 5,
          "text": "أضف معجون الطماطم والبهارات والملح وقلّب على نار متوسطة هادئة.",
          "duration": 2
        },
        {
          "n": 6,
          "text": "أضف الفلفل الرومي وقلّب دقيقة.",
          "duration": 1
        },
        {
          "n": 7,
          "text": "صب الماء المغلي واترك اللحم يطهى على نار متوسطة حتى ينضج (30–40 دقيقة).",
          "duration": 30,
          "passive": true
        },
        {
          "n": 8,
          "text": "بعد نضج اللحم أضف المكرونة واتركها تنضج في المرق (16–18 دقيقة).",
          "duration": 16,
          "passive": true
        },
        {
          "n": 9,
          "text": "قدّمها ساخنة مع سلطة أو خبز.",
          "duration": null
        }
