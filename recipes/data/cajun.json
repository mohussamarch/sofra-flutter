      "steps": [
        {
          "n": 1,
          "text": "حضّر الخضار.",
          "duration": null
        },
        {
          "n": 2,
          "text": "ابدأ الرو: اخلط الزيت والدقيق على النار حتى يصبح لونهما كالشوكولاتة الداكنة. اطههما على نار منخفضة إلى متوسطة نحو 30 دقيقة، أو متوسطة عالية 15–20 دقيقة إذا أردت الطهي الأسرع بحذر.",
          "duration": null
        },
        {
          "n": 3,
          "text": "مع التحريك المتكرر أضف البصل واطهه 5 دقائق.",
          "duration": null
        },
        {
          "n": 4,
          "text": "أضف الكرفس والفلفل واطه 5 دقائق.",
          "duration": null
        },
        {
          "n": 5,
          "text": "أضف الثوم واطه دقيقة.",
          "duration": null
        },
        {
          "n": 6,
          "text": "أضف البيرة ثم المرق.",
          "duration": null
        },
        {
          "n": 7,
          "text": "أضف التوابل وصلصة ورشيسترشاير.",
          "duration": null
        },
        {
          "n": 8,
          "text": "أضف النقانق واترك الخليط يغلي.",
          "duration": null
        },
        {
          "n": 9,
          "text": "خفّض الحرارة وغطّ القدر واتركه يغلي بهدوء 90 دقيقة.",
          "duration": null
        },
        {
          "n": 10,
          "text": "ارفع الحرارة إلى متوسطة وأضف الروبيان واطهه 5–7 دقائق.",
          "duration": null
        },
        {
          "n": 11,
          "text": "أطفئ النار وقدّم الغومبو فوق الأرز الأبيض.",
          "duration": null
        },
        {
          "n": 12,
          "text": "اختياري للبقايا: اغْلِ الغومبو مع أرز أبيض نيء لتحويله إلى جامبالايا.",
          "duration": null
        }
      ],
