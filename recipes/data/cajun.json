      "steps": [
        {
          "n": 1,
          "text": "سخني الفرن إلى 350°F. اخلطي التوابل والأعشاب والملح والفلفل.",
          "duration": null
        },
        {
          "n": 2,
          "text": "اخلطي البصل والكرفس والفلفل الرومي (الثلاثي المقدس كما يسميه المصدر).",
          "duration": null
        },
        {
          "n": 3,
          "text": "في قدر حديد زهر هولندي أذيبي الزبدة على حرارة متوسطة، وأضيفي الأندوي واطهيه حتى يبدأ بالتحمر.",
          "duration": null
        },
        {
          "n": 4,
          "text": "أضيفي نصف خليط الخضروات واطهيه حتى يلين.",
          "duration": null
        },
        {
          "n": 5,
          "text": "أضيفي الطماطم المكعبة واطهي دقيقة. أضيفي صلصة الطماطم واطهي دقيقة أخرى.",
          "duration": null
        },
        {
          "n": 6,
          "text": "أضيفي الأرز واطهيه دقيقتين مع التحريك المستمر.",
          "duration": null
        },
        {
          "n": 7,
          "text": "أضيفي المرق وبقية الخضروات والتوابل وصلصة ورسترشاير والثوم. تذوقي المرق لضبط التوابل، خاصة الملح.",
          "duration": null
        },
        {
          "n": 8,
          "text": "أضيفي الدجاج وقلبي جيدًا ثم ضعي القدر مكشوفًا في الفرن المسخن 25 دقيقة.",
          "duration": null
        },
        {
          "n": 9,
          "text": "أضيفي الروبيان النيئ والبقدونس والبصل الأخضر و أعيدي القدر إلى الفرن 10 دقائق أخرى أو حتى ينضج الروبيان. قدميه فوق الأرز مع خبز فرنسي إذا رغبتِ.",
          "duration": null
        }
      ],
      "tags": [
