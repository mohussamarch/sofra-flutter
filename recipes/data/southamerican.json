          "amount": 1,
          "unit": "ملعقة كبيرة",
          "scale": true,
          "display": null
        }
      ],
      "steps": [
        {
          "n": 1,
          "text": "ضع اللحم المقدد في مقلاة ساخنة. وفي هذه الأثناء اغْلِ مرق الدجاج في قدر منفصل.",
          "duration": null
        },
        {
          "n": 2,
          "text": "أضف الغريتس إلى المرق وحرّك، ثم غطّ القدر واتركه يغلي بهدوء حسب تعليمات العبوة.",
          "duration": null
        },
        {
          "n": 3,
          "text": "عندما ينضج الغريتس أضف الزبدة والملح والفلفل حسب الذوق وحرّك حتى تمتزج.",
          "duration": null
        },
        {
          "n": 4,
          "text": "أضف الجبن وحرّك حتى يندمج.",
          "duration": null
        },
        {
          "n": 5,
          "text": "بعد نضج اللحم المقدد اترك دهنه في المقلاة وأضف الروبيان واقله على حرارة متوسطة عالية.",
          "duration": null
        },
        {
          "n": 6,
          "text": "أضف خلطة الكريول وعصير الليمون وصلصة ورشيسترشاير والثوم وقلّب.",
          "duration": null
        },
        {
          "n": 7,
          "text": "اقله حتى يصبح الروبيان أبيض على الجانبين، نحو 5–7 دقائق إجمالاً.",
          "duration": null
        },
        {
          "n": 8,
          "text": "قدّم الروبيان واللحم المقدد فوق الغريتس وزيّن بالبقدونس.",
          "duration": null
        }
