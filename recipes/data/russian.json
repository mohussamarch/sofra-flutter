    {
      "id": "fiw650-53444",
      "name": "آيس كريم روسي بطابع كلاسيكي",
      "nameEn": "Retro Russian Ice Cream",
      "cuisine": "روسي",
      "category": "حلويات",
      "description": "آيس كريم بالكريمة وصفار البيض يُخفق ويُعاد خفقه أثناء التجميد.",
      "difficulty": "غير محدد بالمصدر",
      "servings": null,
      "prepTime": null,
      "cookTime": null,
      "totalTime": null,
      "metadataPolicy": "source-unknowns-v1",
      "ingredients": [
        {
          "name": "سكر ناعم",
          "amount": 75,
          "unit": "جرام",
          "scale": true,
          "optional": false,
          "note": "المصدر يذكر أيضاً 2.6 أونصة",
          "id": "fiw650-53444-i0",
          "display": null
        },
        {
