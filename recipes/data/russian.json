          "amount": null,
          "unit": null,
          "scale": false,
          "display": "Butter (originally, 1 part butter per 2 parts chicken; 1/4 works perfectly fine)"
        },
        {
          "id": "bc650-pozharskiye-cutlets-ing-3",
