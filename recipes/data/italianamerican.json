      "steps": [
        {
          "n": 1,
          "text": "سخّن الفرن إلى 200°C/400°F.",
          "duration": null
        },
        {
          "n": 2,
          "text": "اخلط جميع المكونات في وعاء.",
          "duration": null
        },
        {
          "n": 3,
          "text": "شكّل كرات بيديك عبر ضغط الخليط ثم تدويره. ضعها على صينية خبز، ويفضل أن تكون عليها شبكة تبريد.",
          "duration": null
        },
        {
          "n": 4,
          "text": "يفضل المصدر كرات كبيرة أكبر من كرة الغولف، ويستهدف 16–20 كرة من رطلين من اللحم؛ وللكرات الأصغر يمكن صنع ما يصل إلى 48.",
          "duration": null
        },
        {
          "n": 5,
          "text": "في منتصف تشكيل الكرات أو بعد الانتهاء سخّن مقلاة كبيرة على حرارة متوسطة عالية.",
          "duration": null
        },
        {
          "n": 6,
          "text": "أضف 1–2 ملعقة كبيرة زيت، بقدر يغطي قاع المقلاة بالتساوي، وسخّنه.",
          "duration": null
        },
        {
          "n": 7,
          "text": "املأ المقلاة بكرات اللحم وحمّر وجهاً، ثم اقلبها بعد 2–3 دقائق وأخرجها إلى صينية الخبز بعد 2–3 دقائق أخرى. واصل على دفعات حتى تحمير الكل. من المتوقع أن تفقد بعض الكرات شكلها الكروي قليلاً.",
          "duration": null
        },
        {
          "n": 8,
          "text": "يمكن تجاوز التحمير والانتقال مباشرة إلى الفرن إذا أردت اختصار الخطوات.",
          "duration": null
        },
        {
          "n": 9,
          "text": "انقلها إلى الفرن واطهها حتى تسجل الحرارة الداخلية 60°C/140°F بمقياس فوري؛ نحو 20 دقيقة للكرات الكبيرة (16 في الدفعة) أو ربما 10 للصغيرة (48 في الدفعة) بحسب المصدر.",
          "duration": null
        },
        {
          "n": 10,
          "text": "قدّمها مع المعكرونة أو في ساندويتش كرات اللحم.",
          "duration": null
        }
      ],
