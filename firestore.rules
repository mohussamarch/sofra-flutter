rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/state/current {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['revision', 'data', 'updatedAt'])
          && d.revision is int && d.data is map
          && d.data.schema == 1 && d.data.name is string
          && d.data.stock is list && d.data.stock.size() <= 1000
          && d.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid()
        && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
