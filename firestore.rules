rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function text(v, max) { return v is string && v.size() >= 1 && v.size() <= max; }
    function kitchenDoc(kid) {
      return get(/databases/$(database)/documents/kitchens/$(kid)).data;
    }
    function stateValid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['revision', 'data', 'updatedAt'])
        && d.revision is int && d.data is map
        && d.data.schema == 1 && d.data.name is string
        && d.data.stock is list && d.data.stock.size() <= 1000
        && d.updatedAt == request.time;
    }

    // Personal kitchen (unchanged).
    match /users/{uid}/state/current {
      function owner() { return signedIn() && me() == uid; }
      allow read: if owner();
      allow create: if owner() && stateValid() && request.resource.data.revision == 1;
      allow update: if owner() && stateValid()
        && request.resource.data.revision == resource.data.revision + 1;
    }

    // Which shared kitchen this account opens; only one it belongs to.
    match /users/{uid}/membership/current {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['kitchenId'])
        && text(request.resource.data.kitchenId, 64)
        && me() in kitchenDoc(request.resource.data.kitchenId).members;
    }

    // A kitchen shared by invitation.
    match /kitchens/{kid} {
      function joining() {
        let n = request.resource.data;
        let o = resource.data;
        let invite = get(/databases/$(database)/documents/invites/$(n.joinedWith)).data;
        return !(me() in o.members)
          && n.members.toSet() == o.members.toSet().union([me()].toSet())
          && n.members.size() == o.members.size() + 1
          && n.members.size() <= 12
          && n.names.diff(o.names).affectedKeys().hasOnly([me()])
          && text(n.names[me()], 60)
          && invite.kitchenId == kid
          && invite.expiresAt > request.time;
      }
      function leaving() {
        let n = request.resource.data;
        let o = resource.data;
        return me() in o.members && me() != o.owner
          && n.members.toSet() == o.members.toSet().difference([me()].toSet())
          && n.members.size() == o.members.size() - 1
          && n.names.diff(o.names).affectedKeys().hasOnly([me()])
          && !(me() in n.names)
          && n.get('joinedWith', null) == o.get('joinedWith', null);
      }
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'members', 'names', 'createdAt'])
        && request.resource.data.owner == me()
        && request.resource.data.members == [me()]
        && request.resource.data.names.keys().hasOnly([me()])
        && text(request.resource.data.names[me()], 60)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'members', 'names', 'createdAt', 'joinedWith'])
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.createdAt == resource.data.createdAt
        && (joining() || leaving());

      match /state/current {
        function member() { return signedIn() && me() in kitchenDoc(kid).members; }
        allow read: if member();
        allow create: if member() && stateValid() && request.resource.data.revision == 1;
        allow update: if member() && stateValid()
          && request.resource.data.revision == resource.data.revision + 1;
      }
    }

    // Invite codes: readable by anyone signed in who knows the code, never
    // listed; made only by a member, for at most a week.
    match /invites/{code} {
      allow get: if signedIn();
      allow list, update, delete: if false;
      allow create: if signedIn()
        && code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['kitchenId', 'by', 'expiresAt'])
        && request.resource.data.by == me()
        && me() in kitchenDoc(request.resource.data.kitchenId).members
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
    }

    // Recipes households share. Photos stay empty until a store is approved.
    match /communityRecipes/{id} {
      function validRecipe() {
        let d = request.resource.data;
        return d.keys().hasAll(['author', 'authorName', 'title', 'servings', 'lines', 'steps', 'photos', 'createdAt'])
          && d.keys().hasOnly(['author', 'authorName', 'title', 'cuisine', 'servings', 'lines', 'steps', 'photos', 'createdAt'])
          && d.author == me()
          && text(d.authorName, 60) && text(d.title, 80)
          && (!('cuisine' in d) || text(d.cuisine, 40))
          && d.servings is int && d.servings >= 1 && d.servings <= 50
          && d.lines is list && d.lines.size() >= 1 && d.lines.size() <= 60
          && d.steps is list && d.steps.size() >= 1 && d.steps.size() <= 40
          && d.photos is list && d.photos.size() == 0
          && d.createdAt == request.time;
      }
      allow read: if signedIn();
      allow create: if signedIn() && id.matches('^' + me() + '-[A-Za-z0-9_-]+$') && validRecipe();
      allow update: if signedIn() && resource.data.author == me() && validRecipe();
      allow delete: if signedIn() && resource.data.author == me();

      match /ratings/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['name', 'stars', 'comment', 'at'])
          && text(request.resource.data.name, 60)
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 500
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && me() == uid;
      }
    }

    // Prices people paid, by country and area.
    match /priceReports/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'country', 'area', 'ingredientId', 'quantity', 'unit', 'amount', 'paidOn', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.country in ['EG', 'SA']
        && text(request.resource.data.area, 60)
        && text(request.resource.data.ingredientId, 80)
        && text(request.resource.data.unit, 20)
        && request.resource.data.quantity is number && request.resource.data.quantity > 0
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.amount < 1000000
        && request.resource.data.paidOn is string
        && request.resource.data.paidOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.uid == me();
      allow update: if false;
    }

    // Text stories that last a day. Photos stay empty until a store is approved.
    match /stories/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'name', 'text', 'color', 'photos', 'createdAt', 'expiresAt'])
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'dish', 'color', 'photos', 'createdAt', 'expiresAt'])
        && request.resource.data.uid == me()
        && text(request.resource.data.name, 60)
        && text(request.resource.data.text, 200)
        && (!('dish' in request.resource.data) || text(request.resource.data.dish, 80))
        && request.resource.data.color is int
        && request.resource.data.color >= 0 && request.resource.data.color <= 7
        && request.resource.data.photos is list && request.resource.data.photos.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');
      allow delete: if signedIn() && resource.data.uid == me();
      allow update: if false;
    }

    // Weekly challenge leaderboard; each household writes its own line.
    match /challenges/{week}/entries/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name', 'progress', 'goal', 'at'])
        && text(request.resource.data.name, 60)
        && request.resource.data.progress is int
        && request.resource.data.progress >= 0 && request.resource.data.progress <= 100
        && request.resource.data.goal is int
        && request.resource.data.goal >= 1 && request.resource.data.goal <= 20
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && me() == uid;
    }
  }
}
