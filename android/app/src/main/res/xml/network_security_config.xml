<?xml version="1.0" encoding="utf-8"?>
<!-- The 3D kitchen runs in a WebView fed by a local HTTP server on the phone
     itself (the app's own asset server, lib/scene3d/asset_server_io.dart).
     Plain HTTP is allowed for the loopback address only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
